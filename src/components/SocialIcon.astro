---
/**
 * Icône SVG inline d'un réseau social. Inline plutôt qu'un widget ou
 * une police d'icônes : zéro requête tierce (RGPD), et la couleur suit
 * `currentColor` pour hériter des tokens du parent.
 */
interface Props {
	name: "facebook" | "instagram" | "tiktok";
	size?: number;
}
const { name, size = 18 } = Astro.props;
---

{
	name === "facebook" && (
		<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
			<path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.2-1.5 1.6-1.5h1.6V3.7c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.1H7.4v3.1h2.7v8h3.4z" />
		</svg>
	)
}
{
	name === "instagram" && (
		<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="5" />
			<circle cx="12" cy="12" r="4" />
			<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
		</svg>
	)
}
{
	name === "tiktok" && (
		<svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
			<path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 0 1-2.59-2.59 2.59 2.59 0 0 1 3.36-2.47V9.69a5.73 5.73 0 0 0-.77-.05 5.68 5.68 0 0 0-5.68 5.68A5.68 5.68 0 0 0 9.86 21a5.68 5.68 0 0 0 5.68-5.68V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z" />
		</svg>
	)
}
