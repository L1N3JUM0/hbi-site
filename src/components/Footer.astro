---
import { Image } from "astro:assets";
import logoSrc from "../assets/logo-transparent-blanc.png";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="brand">
			<Image src={logoSrc} alt="Handball Islois" width={120} height={120} format="webp" />
		</div>

		<div class="cols">
			<div class="col">
				<p class="col-label">Le club</p>
				<p class="club-name">Handball Islois</p>
				<p>COSEC Émile Avy</p>
				<p>Avenue Jean Bouin, 84800 L&rsquo;Isle-sur-la-Sorgue</p>
			</div>

			<div class="col">
				<p class="col-label">Contact</p>
				<p><a href="tel:0626621544">06 26 62 15 44</a></p>
				<p><a href="mailto:6384006@sud.ffhandball.net">6384006@sud.ffhandball.net</a></p>
			</div>

			<div class="col">
				<p class="col-label">Réseaux</p>
				<p>
					<a class="social-link" href="https://www.facebook.com/handballislois84" target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
							<path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.2-1.5 1.6-1.5h1.6V3.7c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.1H7.4v3.1h2.7v8h3.4z" />
						</svg>
						<span>Facebook&nbsp;: Handball Islois</span>
					</a>
				</p>
				<p>
					<a class="social-link" href="https://www.instagram.com/handball.islois/" target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5" />
							<circle cx="12" cy="12" r="4" />
							<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
						</svg>
						<span>Instagram&nbsp;: @handball_islois</span>
					</a>
				</p>
			</div>
		</div>

		<p class="copy">&copy; {year} Handball Islois</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-navy-deep);
		padding: 3rem 1.5rem 1.5rem;
	}
	.wrap {
		max-width: 900px;
		margin: 0 auto;
	}

	.brand {
		display: flex;
		justify-content: center;
		margin-bottom: 2rem;
	}
	.brand :global(img) {
		height: 40px;
		width: auto;
		opacity: 0.9;
	}

	.cols {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.25rem;
		text-align: center;
	}
	.col-label {
		color: var(--color-crimson);
		font-weight: 800;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin: 0 0 0.75rem !important;
	}
	.col p {
		color: rgba(255, 255, 255, 0.75);
		font-size: 1rem;
		line-height: 1.6;
		margin: 0 0 0.3rem;
	}
	.club-name {
		color: var(--color-white) !important;
		font-weight: 800;
		font-size: 1.05rem !important;
		margin-bottom: 0.5rem !important;
	}
	.col a {
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
	}
	.col a:hover {
		color: var(--color-crimson);
	}
	.social-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.copy {
		text-align: center;
		color: rgba(255, 255, 255, 0.4);
		font-size: 0.8rem;
		margin: 2.75rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	@media (min-width: 700px) {
		.cols {
			grid-template-columns: repeat(3, 1fr);
			gap: 0;
		}
		.col {
			padding: 0 2rem;
			border-left: 1px solid rgba(255, 255, 255, 0.12);
		}
		.col:first-child {
			border-left: none;
		}
	}
</style>
