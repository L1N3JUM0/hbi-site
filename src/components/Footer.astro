const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<div class="col">
			<p class="club-name">Handball Islois</p>
			<p>COSEC Émile Avy</p>
			<p>Avenue Jean Bouin, 84800 L&rsquo;Isle-sur-la-Sorgue</p>
		</div>

		<div class="col">
			<p><a href="tel:0626621544">06 26 62 15 44</a></p>
			<p><a href="mailto:6384006@sud.ffhandball.net">6384006@sud.ffhandball.net</a></p>
		</div>

		<div class="col">
			<p><a href="https://www.facebook.com/handballislois84" target="_blank" rel="noopener noreferrer">Facebook&nbsp;: Handball Islois</a></p>
			<p><a href="https://www.instagram.com/handball.islois/" target="_blank" rel="noopener noreferrer">Instagram&nbsp;: @handball_islois</a></p>
