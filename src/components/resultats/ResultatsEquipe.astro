---
import ListeResultats from "./ListeResultats.astro";
import { getResultatsForEquipe, resultatsParSaison, aPlusieursEquipes, ordreGroupesEquipe } from "../../lib/resultats";

interface Props {
	equipeSlug: string;
	affichageStats: "nominatif" | "pseudonymise" | "masque";
	/** Calendriers actuels de la fiche équipe (voir content.config.ts) --
	 * sert uniquement à ordonner et nommer les groupes quand la catégorie
	 * compte plusieurs équipes (voir ordreGroupesEquipe() dans
	 * src/lib/resultats.ts) ; sans effet pour une catégorie à équipe unique. */
	calendriers?: { libelle?: string }[];
}

const { equipeSlug, affichageStats, calendriers = [] } = Astro.props;
const tousLesResultats = await getResultatsForEquipe(equipeSlug);
const { saisonEnCours, saisonsPrecedentes } = resultatsParSaison(tousLesResultats);

/** `null` pour une catégorie à équipe unique : ListeResultats affiche alors
 * une liste plate, sans groupe ni libellé -- aucun changement par rapport à
 * avant. Calculé UNE fois sur TOUS les résultats (pas seulement la saison en
 * cours) pour que la saison en cours et les archives utilisent le même
 * ordre et les mêmes libellés de groupe. */
const ordreGroupes = aPlusieursEquipes(tousLesResultats) ? ordreGroupesEquipe(tousLesResultats, calendriers) : null;
---

{
	saisonEnCours.length > 0 && (
		<details class="resultats">
			<summary>Résultats ({saisonEnCours.length})</summary>
			<ListeResultats resultats={saisonEnCours} affichageStats={affichageStats} ordreGroupes={ordreGroupes} />
		</details>
	)
}

{
	saisonsPrecedentes.length > 0 && (
		<details class="resultats resultats--archives">
			<summary>Saisons précédentes</summary>
			{saisonsPrecedentes.map(({ saison, resultats }) => (
				<details class="saison">
					<summary>
						{saison} ({resultats.length})
					</summary>
					<ListeResultats resultats={resultats} affichageStats={affichageStats} ordreGroupes={ordreGroupes} />
				</details>
			))}
		</details>
	)
}

<style>
	.resultats {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}
	.resultats > summary {
		cursor: pointer;
		list-style: none;
		color: var(--color-white);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	.resultats > summary::-webkit-details-marker {
		display: none;
	}
	.resultats > summary::before {
		content: "▸";
		display: inline-block;
		margin-right: 0.5rem;
		transition: transform 0.15s ease;
	}
	.resultats[open] > summary::before {
		transform: rotate(90deg);
	}

	.saison {
		margin: 0.5rem 0 0 1rem;
	}
	.saison > summary {
		cursor: pointer;
		list-style: none;
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.8rem;
		font-weight: 700;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	.saison > summary::-webkit-details-marker {
		display: none;
	}
	.saison > summary::before {
		content: "▸";
		display: inline-block;
		margin-right: 0.5rem;
		transition: transform 0.15s ease;
	}
	.saison[open] > summary::before {
		transform: rotate(90deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.resultats > summary::before,
		.saison > summary::before {
			transition: none;
		}
	}
</style>
