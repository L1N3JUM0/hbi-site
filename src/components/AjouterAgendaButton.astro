---
interface Props {
	href: string;
	label?: string;
}
const { href, label = "Ajouter à mon agenda" } = Astro.props;
---

<a class="agenda-btn" href={href}>
	<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
		<rect x="3" y="5" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="2" />
		<path d="M3 9h18M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
	</svg>
	{label}
</a>

<style>
	.agenda-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		background: transparent;
		color: var(--color-white);
		border: 2px solid rgba(255, 255, 255, 0.4);
		border-radius: 999px;
		padding: 0.5rem 1rem;
		font-weight: 700;
		font-size: 0.85rem;
		text-decoration: none;
		min-height: 44px;
		box-sizing: border-box;
	}
	.agenda-btn:hover {
		border-color: var(--color-crimson);
		color: var(--color-crimson);
	}
</style>
