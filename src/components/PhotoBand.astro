---
import { getCollection } from "astro:content";
import PhotoCarousel from "./PhotoCarousel.astro";

const entries = (await getCollection("photosAccueil")).sort((a, b) => a.data.ordre - b.data.ordre);
const photos = entries.map((entry) => ({ src: entry.data.image, alt: entry.data.alt }));
---

<section class="photo-band">
	<div class="kicker-wrap">
		<p class="kicker">La vie du club, en images</p>
	</div>
	<PhotoCarousel photos={photos} ariaLabel="Photos du club, faites défiler avec les flèches du clavier" variant="band" />
</section>

<style>
	.photo-band {
		background: var(--color-navy-deep);
		padding: 1.5rem 0;
	}
	.kicker-wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.kicker {
		color: var(--color-white);
		text-align: center;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}
</style>
