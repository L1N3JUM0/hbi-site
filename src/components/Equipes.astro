---
const featured = [
	{
		name: "Baby Hand",
		meta: "4-6 ans · samedi 9h-10h",
		tag: "Découverte",
		blurb: "Les premiers pas avec le ballon, dans la bonne humeur.",
	},
	{
		name: "Handensemble",
		meta: "Handball adapté · mercredi 18h-19h",
		tag: "Inclusion",
		blurb:
			"Le handball adapté et inclusif, ouvert à tous. Un vrai différenciateur du club, encore rare chez les clubs amateurs.",
	},
];

const teams = [
	"U9 mixtes",
	"U11 mixtes",
	"U13 féminines",
	"U13 masculins",
	"U15 féminines",
	"U15 masculins",
	"U17 féminines",
	"U18 masculins",
	"Seniors féminines",
	"Seniors masculins",
	"Loisirs",
];
---

<section class="equipes">
	<div class="wrap">
		<h2>Nos équipes</h2>
		<p class="intro">
			Du baby hand aux seniors, en passant par le handball adapté&nbsp;: le
			HBI a une place pour chaque âge et chaque envie.
		</p>

		<div class="featured-grid">
			{
				featured.map((f) => (
					<div class="featured-card">
						<span class="tag">{f.tag}</span>
						<h3>{f.name}</h3>
						<p class="meta">{f.meta}</p>
						<p class="blurb">{f.blurb}</p>
					</div>
				))
			}
		</div>

		<div class="teams-grid">
			{
				teams.map((t) => (
					<div class="team-card">
						<span>{t}</span>
					</div>
				))
			}
			<div class="team-card team-card--transversal">
				<span>Étirements, renforcement &amp; spé gardien</span>
				<span class="team-card__note">Créneau transversal · U15 à Seniors</span>
			</div>
		</div>

		<a class="see-all" href="/equipes">Voir toutes les équipes →</a>
	</div>
</section>

<style>
	.equipes {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.wrap {
		max-width: 1000px;
		margin: 0 auto;
	}
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		text-align: center;
		margin: 0 0 0.75rem;
	}
	.intro {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
		max-width: 560px;
		margin: 0 auto 2.5rem;
		line-height: 1.6;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}
	.featured-card {
		background: var(--color-white);
		border-radius: 16px;
		padding: 1.75rem;
		position: relative;
	}
	.featured-card .tag {
		display: inline-block;
		background: var(--color-crimson);
		color: var(--color-white);
		font-weight: 800;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		margin-bottom: 0.9rem;
	}
	.featured-card h3 {
		color: var(--color-navy-deep);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.35rem;
		margin: 0 0 0.35rem;
	}
	.featured-card .meta {
		color: var(--color-blue);
		font-weight: 700;
		font-size: 1rem;
		margin: 0 0 0.75rem;
	}
	.featured-card .blurb {
		color: var(--color-navy-deep);
		font-size: 1rem;
		line-height: 1.5;
		margin: 0;
	}

	.teams-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 0.75rem;
		margin-bottom: 2rem;
	}
	.team-card {
		background: var(--color-blue);
		border-radius: 10px;
		padding: 1rem 0.9rem;
		min-height: 64px;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	.team-card span {
		color: var(--color-white);
		font-weight: 700;
		font-size: 1rem;
		line-height: 1.3;
	}
	.team-card--transversal {
		grid-column: 1 / -1;
		flex-direction: column;
		gap: 0.2rem;
		background: var(--color-navy);
	}
	.team-card__note {
		font-weight: 500 !important;
		font-size: 0.9rem !important;
		color: rgba(255, 255, 255, 0.7) !important;
	}

	.see-all {
		display: block;
		width: fit-content;
		margin: 0 auto;
		color: var(--color-white);
		font-weight: 800;
		text-decoration: none;
		border-bottom: 2px solid var(--color-crimson);
		padding-bottom: 0.15rem;
	}
	.see-all:hover {
		color: var(--color-crimson);
	}
</style>
