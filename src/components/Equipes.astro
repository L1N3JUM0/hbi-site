---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { withBase } from "../utils/links";

const allTeams = (await getCollection("equipes"))
	.filter((t) => t.data.statut !== "archivee")
	.sort((a, b) => a.data.ordre - b.data.ordre);
const competition = allTeams.filter((t) => t.data.type === "competition");
const decouverte = allTeams.filter((t) => t.data.type === "decouverte" || t.data.type === "inclusion");

const typeLabel: Record<string, string> = {
	decouverte: "Découverte",
	inclusion: "Inclusion",
};
---

<section class="equipes">
	<div class="wrap">
		<h2>Nos équipes</h2>
		<p class="intro">
			Du baby hand aux seniors, en passant par le handball adapté&nbsp;: le
			HBI a une place pour chaque âge et chaque envie.
		</p>

		<div class="teams-board">
			{
				competition.map((t) => (
					<a class="team-cell" href={withBase(`/equipes#${t.data.slug}`)}>
						<Image src={t.data.photoProfil} alt="" width={440} height={440} format="webp" loading="lazy" />
						<span class="team-cell__overlay">
							<span class="team-cell__name">{t.data.nom}</span>
							<span class="team-cell__desc">{t.data.description}</span>
						</span>
					</a>
				))
			}
		</div>

		<div class="decouverte-row">
			{
				decouverte.map((t) => (
					<a class="decouverte-card" href={withBase(`/equipes#${t.data.slug}`)}>
						<Image src={t.data.photoProfil} alt="" width={160} height={160} format="webp" loading="lazy" />
						<span class="decouverte-card__body">
							<span class="tag">{typeLabel[t.data.type]}</span>
							<span class="decouverte-card__name">{t.data.nom}</span>
							<span class="decouverte-card__desc">{t.data.description}</span>
						</span>
					</a>
				))
			}
		</div>

		<a class="see-all" href={withBase("/equipes")}>Voir toutes les équipes →</a>
	</div>
</section>

<script>
	// Sur écran tactile, :hover ne se déclenche pas -- le premier tap révèle
	// la description (au lieu de suivre le lien), le second tap navigue.
	if (window.matchMedia("(hover: none)").matches) {
		document.querySelectorAll<HTMLAnchorElement>(".team-cell, .decouverte-card").forEach((card) => {
			card.addEventListener("click", (e) => {
				if (!card.classList.contains("is-active")) {
					e.preventDefault();
					document
						.querySelectorAll(".team-cell.is-active, .decouverte-card.is-active")
						.forEach((c) => c.classList.remove("is-active"));
					card.classList.add("is-active");
				}
			});
		});
	}
</script>

<style>
	.equipes {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.wrap {
		max-width: 1000px;
		margin: 0 auto;
	}
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		text-align: center;
		margin: 0 0 0.75rem;
	}
	.intro {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
		max-width: 560px;
		margin: 0 auto 2rem;
		line-height: 1.6;
	}

	.teams-board {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-auto-rows: 110px;
		gap: 3px;
		margin-bottom: 1.75rem;
	}
	.team-cell {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--color-navy);
		text-decoration: none;
	}
	.team-cell :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.team-cell__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 0.5rem 0.6rem;
		background: linear-gradient(to top, rgba(0, 23, 73, 0.92) 0%, rgba(0, 23, 73, 0.25) 55%, transparent 80%);
	}
	.team-cell__name {
		color: var(--color-white);
		font-weight: 800;
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		line-height: 1.25;
	}
	.team-cell__desc {
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.8rem;
		line-height: 1.35;
		margin-top: 0.35rem;
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition: max-height 0.2s ease, opacity 0.2s ease;
	}
	.team-cell:hover .team-cell__desc,
	.team-cell:focus-visible .team-cell__desc,
	.team-cell.is-active .team-cell__desc {
		max-height: 5rem;
		opacity: 1;
	}
	.team-cell:focus-visible {
		outline: 3px solid var(--color-white);
		outline-offset: -3px;
	}

	.decouverte-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0.75rem;
		margin-bottom: 2.25rem;
	}
	.decouverte-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		border-left: 3px solid var(--color-crimson);
		padding: 0.6rem 0.9rem;
		text-decoration: none;
		background: rgba(255, 255, 255, 0.03);
	}
	.decouverte-card :global(img) {
		width: 56px;
		height: 56px;
		object-fit: cover;
		flex-shrink: 0;
	}
	.decouverte-card__body {
		display: flex;
		flex-direction: column;
	}
	.decouverte-card .tag {
		display: inline-block;
		background: var(--color-crimson);
		color: var(--color-white);
		font-weight: 800;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.2rem 0.55rem;
		margin-bottom: 0.4rem;
		width: fit-content;
	}
	.decouverte-card__name {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.05rem;
		margin: 0 0 0.2rem;
	}
	.decouverte-card__desc {
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.8rem;
		line-height: 1.3;
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition: max-height 0.2s ease, opacity 0.2s ease;
	}
	.decouverte-card:hover .decouverte-card__desc,
	.decouverte-card:focus-visible .decouverte-card__desc,
	.decouverte-card.is-active .decouverte-card__desc {
		max-height: 5rem;
		opacity: 1;
	}
	.decouverte-card:focus-visible {
		outline: 2px solid var(--color-white);
		outline-offset: 2px;
	}

	.see-all {
		display: block;
		width: fit-content;
		margin: 0 auto;
		color: var(--color-white);
		font-weight: 800;
		text-decoration: none;
		border-bottom: 2px solid var(--color-crimson);
		padding-bottom: 0.15rem;
	}
	.see-all:hover {
		color: var(--color-crimson);
	}

	@media (max-width: 640px) {
		.teams-board {
			grid-template-columns: repeat(2, 1fr);
			grid-auto-rows: 130px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.team-cell__desc,
		.decouverte-card__desc {
			transition: none;
		}
	}
</style>
