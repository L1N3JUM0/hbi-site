---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

const page = await getEntry("photosHero", "page");
const photos = (page?.data.photos ?? []).map((p) => ({ src: p.image, alt: p.alt, cadrage: p.cadrage }));
const n = photos.length;

/** Traduit le cadrage choisi dans le CMS en `object-position` CSS : ne
 * touche jamais au fichier d'origine, seule la portion visible dans le
 * cadre (rogné en haut/bas par le format très large du hero) change. */
const OBJECT_POSITION: Record<string, string> = {
	haut: "center top",
	centre: "center center",
	bas: "center bottom",
};

/* Rythme du diaporama : chaque photo reste pleinement visible ~6,2s, avec un
   fondu enchaîné de 1,8s qui la fait chevaucher la photo suivante -- jamais
   de coupe franche ni de passage par le noir. SEGMENT est le temps ABSOLU
   entre le début d'apparition de deux photos consécutives : il ne dépend pas
   du nombre de photos, donc en ajouter ou en retirer depuis le CMS ne change
   jamais le rythme perçu, seulement la durée totale d'un cycle complet. */
const FADE = 1.8;
const HOLD = 6.2;
const SEGMENT = FADE + HOLD;
const totalDuration = Math.max(n, 1) * SEGMENT;

const round = (value: number) => Math.round(value * 1000) / 1000;
const fadeInPct = round((FADE / totalDuration) * 100);
const segmentPct = round((SEGMENT / totalDuration) * 100);
const fadeOutEndPct = round(((SEGMENT + FADE) / totalDuration) * 100);

/* 4 mouvements de zoom/dérive différents, appliqués à tour de rôle : évite
   l'effet "même zoom appliqué à toutes les photos" qui trahit un diaporama
   automatique. Amplitude volontairement faible (8-10%) pour rester sobre. */
const variants = ["hero-zoom-in", "hero-pan-left", "hero-zoom-out", "hero-pan-right"];

/* Les pourcentages de ces keyframes dépendent du nombre de photos (via
   fadeInPct/segmentPct/fadeOutEndPct) : ils doivent donc être générés au
   build plutôt qu'écrits en dur -- une <style> Astro classique ne permet pas
   d'interpoler des sélecteurs de keyframes, d'où le set:html ci-dessous. */
const dynamicCss =
	n >= 2
		? `
@keyframes hero-fade {
	0% { opacity: 0; }
	${fadeInPct}% { opacity: 1; }
	${segmentPct}% { opacity: 1; }
	${fadeOutEndPct}% { opacity: 0; }
	100% { opacity: 0; }
}
@keyframes hero-fade-first {
	0% { opacity: 1; }
	${segmentPct}% { opacity: 1; }
	${fadeOutEndPct}% { opacity: 0; }
	100% { opacity: 0; }
}
@keyframes hero-zoom-in {
	0% { transform: scale(1); }
	${fadeOutEndPct}% { transform: scale(1.1); }
	100% { transform: scale(1.1); }
}
@keyframes hero-zoom-out {
	0% { transform: scale(1.1); }
	${fadeOutEndPct}% { transform: scale(1); }
	100% { transform: scale(1); }
}
@keyframes hero-pan-left {
	0% { transform: scale(1.1) translateX(3%); }
	${fadeOutEndPct}% { transform: scale(1.1) translateX(-3%); }
	100% { transform: scale(1.1) translateX(-3%); }
}
@keyframes hero-pan-right {
	0% { transform: scale(1.1) translateX(-3%); }
	${fadeOutEndPct}% { transform: scale(1.1) translateX(3%); }
	100% { transform: scale(1.1) translateX(3%); }
}
`.trim()
		: "";

const HERO_WIDTHS = [480, 768, 1080, 1440, 1920];
---

<section class="hero">
	<div class="hero-viewport">
		{
			photos.map((photo, i) => {
				const isFirst = i === 0;
				const delay = round(i * SEGMENT);
				const slideStyle = n >= 2 ? `animation-name: ${isFirst ? "hero-fade-first" : "hero-fade"}; animation-duration: ${totalDuration}s; animation-delay: ${delay}s;` : undefined;
				const mediaStyle = n >= 2 ? `animation-duration: ${totalDuration}s; animation-delay: ${delay}s;` : undefined;
				return (
					<div class:list={["slide", isFirst && "is-first"]} style={slideStyle}>
						<div class:list={["slide-media", variants[i % variants.length]]} style={mediaStyle}>
							<Image
								src={photo.src}
								alt={photo.alt}
								width={photo.src.width}
								widths={HERO_WIDTHS}
								sizes="100vw"
								format="avif"
								loading="eager"
								decoding={isFirst ? "sync" : "async"}
								fetchpriority={isFirst ? "high" : "low"}
								style={`object-position: ${OBJECT_POSITION[photo.cadrage] ?? OBJECT_POSITION.centre};`}
							/>
						</div>
					</div>
				);
			})
		}

		<div class="scrim" aria-hidden="true"></div>

		<p class="motto">
			<span class="line1">Je ne perds jamais</span>
			<span class="line2">soit je gagne, soit j&rsquo;apprends.</span>
		</p>
	</div>
</section>

<style set:html={dynamicCss} />

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--color-navy-deep);
	}

	.hero-viewport {
		--header-h: 64px;
		--hero-peek: 260px;
		position: relative;
		width: 100%;
		height: clamp(280px, calc(100vh - var(--header-h) - var(--hero-peek)), 480px);
		overflow: hidden;
	}

	.slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
	}
	.slide.is-first {
		opacity: 1;
	}

	.slide-media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		transform-origin: center center;
		animation-timing-function: ease-in-out;
		animation-iteration-count: infinite;
		will-change: transform;
	}
	/* La classe de variante (posée en template) ne fait que choisir QUELLE
	   keyframe jouer : animation-name doit être fixé ici pour chacune, sinon
	   .slide-media n'a tout simplement aucune animation de transform. */
	.slide-media.hero-zoom-in {
		animation-name: hero-zoom-in;
	}
	.slide-media.hero-zoom-out {
		animation-name: hero-zoom-out;
	}
	.slide-media.hero-pan-left {
		animation-name: hero-pan-left;
	}
	.slide-media.hero-pan-right {
		animation-name: hero-pan-right;
	}
	.slide-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 23, 73, 0.32) 0%,
			rgba(0, 23, 73, 0.22) 35%,
			rgba(0, 23, 73, 0.55) 68%,
			rgba(0, 23, 73, 0.85) 100%
		);
		pointer-events: none;
	}

	.motto {
		position: absolute;
		left: 1.5rem;
		right: 1.5rem;
		bottom: 1.25rem;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		text-shadow: 0 2px 12px rgba(0, 10, 30, 0.6);
	}
	.motto .line1 {
		font-size: clamp(1.25rem, 5vw, 2rem);
	}
	.motto .line2 {
		font-size: clamp(1rem, 3.6vw, 1.5rem);
	}

	@media (min-width: 900px) {
		.motto {
			left: auto;
			right: 3rem;
			bottom: 2.5rem;
			max-width: 480px;
			text-align: right;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.slide,
		.slide-media {
			animation: none !important;
		}
		.slide {
			opacity: 0;
		}
		.slide.is-first {
			opacity: 1;
		}
		.slide-media {
			transform: none !important;
		}
	}
</style>
