---
/**
 * "Carte joueur" (phase D, cahier des charges du 30/09/2026) : une carte
 * façon carte à collectionner, générée ENTIÈREMENT dans le navigateur.
 *
 * - Aucune image, aucun surnom, aucun poste n'est envoyé ni enregistré :
 *   pas de requête réseau, pas de stockage (ni localStorage ni cookie) ; tout
 *   est oublié à la fermeture de la fenêtre.
 * - Réservée aux joueur·se·s affiché·e·s en nom complet (décision du
 *   30/09/2026) : pour une catégorie pseudonymisée, initiale + catégorie +
 *   équipe suffisent à recouper l'identité d'un enfant, la fonction
 *   n'existe donc pas (aucun bouton, voir statistiques-carriere.astro ; et
 *   refus ici par précaution). Nom tel qu'affiché, ou surnom facultatif.
 * - Mention "Carte personnelle, non officielle" sur toutes les cartes :
 *   n'importe qui peut générer la carte d'un·e joueur·se listé·e, avec
 *   n'importe quelle photo, l'image ne doit pas passer pour un document du
 *   club.
 * - Identité du club uniquement (tokens de couleur, logo du HBI, silhouette
 *   du logo en motif de fond) : inspirée de la mise en page des cartes à
 *   collectionner récentes, sans aucun élément de marque d'un produit ou
 *   d'une compétition.
 * - Jamais de numéro de licence ni d'empreinte : la page n'en contient pas,
 *   et un PNG issu d'un canvas ne porte pas les métadonnées de la photo.
 */
import { getImage } from "astro:assets";
import logo from "../assets/logo-transparent-blanc.png";
import silhouetteBrute from "../assets/player/pose-4-tir-reference.svg?raw";

interface Props {
	saisonEnCours: string;
	saisonDebut: string | undefined;
}
const { saisonEnCours, saisonDebut } = Astro.props;

// Logo redimensionné au build : l'original fait 1254 px et 685 Ko.
const logoCarte = await getImage({ src: logo, width: 320, format: "png" });
// Silhouette du logo en blanc (motif de fond, voir CLAUDE.md : LA référence
// de style pour tout élément graphique dérivé du logo).
const silhouette = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(silhouetteBrute.replace(/fill="#0259AA"/g, 'fill="#FFFFFF"'))}`;
---

<dialog id="carte-joueur" class="carte-dialog" aria-labelledby="carte-titre" data-logo={logoCarte.src} data-silhouette={silhouette} data-saison={saisonEnCours} data-debut={saisonDebut ?? ""}>
	<form method="dialog" class="carte-fermer-form">
		<button class="carte-fermer" aria-label="Fermer la carte joueur">×</button>
	</form>
	<h2 id="carte-titre">Carte joueur</h2>
	<div class="carte-grille">
		<div class="carte-apercu">
			<canvas width="1080" height="1350" aria-label="Aperçu de la carte joueur" role="img"></canvas>
			<p class="carte-aide">Glisse la photo dans l'aperçu pour la déplacer.</p>
		</div>
		<div class="carte-reglages">
			<label class="carte-label" for="carte-photo">Photo (facultative)</label>
			<input id="carte-photo" type="file" accept="image/*" />
			<p class="carte-confidentialite">Ta photo reste sur ton appareil : elle n'est ni envoyée, ni enregistrée.</p>

			<fieldset class="carte-cadrage" disabled>
				<legend class="carte-label">Cadrage</legend>
				<label class="carte-sous-label" for="carte-zoom">Zoom</label>
				<input id="carte-zoom" type="range" min="1" max="3" step="0.01" value="1" />
				<div class="carte-fleches" role="group" aria-label="Déplacer la photo">
					<button type="button" data-dx="-1" data-dy="0" aria-label="Déplacer à gauche">←</button>
					<button type="button" data-dx="0" data-dy="-1" aria-label="Déplacer vers le haut">↑</button>
					<button type="button" data-dx="0" data-dy="1" aria-label="Déplacer vers le bas">↓</button>
					<button type="button" data-dx="1" data-dy="0" aria-label="Déplacer à droite">→</button>
					<button type="button" class="carte-recentrer">Recentrer</button>
				</div>
			</fieldset>

			<label class="carte-label" for="carte-surnom">Surnom (facultatif)</label>
			<input id="carte-surnom" type="text" maxlength="18" autocomplete="off" />

			<label class="carte-label" for="carte-poste">Poste (facultatif)</label>
			<select id="carte-poste">
				<option value="">—</option>
				<option>Ailier G</option>
				<option>Arrière G</option>
				<option>Demi</option>
				<option>Arrière D</option>
				<option>Ailier D</option>
				<option>Pivot</option>
				<option>Gardien</option>
			</select>
			<p class="carte-note">Gardien : les arrêts remplacent les buts sur la carte.</p>

			<fieldset class="carte-format">
				<legend class="carte-label">Format</legend>
				<label><input type="radio" name="carte-format" value="1350" checked /> Portrait 4:5</label>
				<label><input type="radio" name="carte-format" value="1920" /> Story 9:16</label>
			</fieldset>

			<div class="carte-actions">
				<button type="button" class="carte-partager" hidden>Partager</button>
				<button type="button" class="carte-telecharger">Télécharger</button>
			</div>
		</div>
	</div>
</dialog>

<script>
	type Stats = { matchs: number; buts: number; arrets: number };
	type Joueur = { nom: string; equipe: string; nominatif: boolean; carriere: Stats; saison: Stats; record: boolean };

	const dialog = document.querySelector<HTMLDialogElement>("#carte-joueur");
	if (dialog) {
		const canvas = dialog.querySelector("canvas")!;
		const ctx = canvas.getContext("2d")!;
		const champPhoto = dialog.querySelector<HTMLInputElement>("#carte-photo")!;
		const champZoom = dialog.querySelector<HTMLInputElement>("#carte-zoom")!;
		const cadrage = dialog.querySelector<HTMLFieldSetElement>(".carte-cadrage")!;
		const champSurnom = dialog.querySelector<HTMLInputElement>("#carte-surnom")!;
		const champPoste = dialog.querySelector<HTMLSelectElement>("#carte-poste")!;
		const boutonPartager = dialog.querySelector<HTMLButtonElement>(".carte-partager")!;
		const boutonTelecharger = dialog.querySelector<HTMLButtonElement>(".carte-telecharger")!;
		const saison = dialog.dataset.saison ?? "";
		const debut = dialog.dataset.debut ?? "";

		const charger = (src: string) =>
			new Promise<HTMLImageElement>((ok, ko) => {
				const img = new Image();
				img.onload = () => ok(img);
				img.onerror = ko;
				img.src = src;
			});
		const ressources = Promise.all([charger(dialog.dataset.logo!), charger(dialog.dataset.silhouette!)]);

		// État de la génération en cours : jamais persisté, remis à zéro à chaque ouverture.
		let joueur: Joueur | null = null;
		let photo: HTMLImageElement | null = null;
		let urlPhoto: string | null = null;
		let decalage = { x: 0, y: 0 };

		const couleur = (nom: string) => getComputedStyle(document.documentElement).getPropertyValue(nom).trim();
		const police = (taille: number, graisse = 800) => `${graisse} ${taille}px system-ui, -apple-system, "Segoe UI", sans-serif`;

		/** Zone de la photo, en pixels de la carte (dépend du format). */
		function cadrePhoto(W: number, H: number) {
			const y = H * 0.16;
			return { x: 80, y, l: W - 160, h: H * (H > 1500 ? 0.52 : 0.46) };
		}

		function arrondi(x: number, y: number, l: number, h: number, r: number) {
			ctx.beginPath();
			ctx.roundRect(x, y, l, h, r);
		}

		function texteAjuste(texte: string, largeurMax: number, taille: number, graisse = 800) {
			let t = taille;
			ctx.font = police(t, graisse);
			while (ctx.measureText(texte).width > largeurMax && t > 20) {
				t -= 2;
				ctx.font = police(t, graisse);
			}
			return t;
		}

		async function dessiner() {
			if (!joueur) return;
			await document.fonts.ready;
			const [imgLogo, imgSilhouette] = await ressources;
			const W = canvas.width;
			const H = canvas.height;
			const blanc = couleur("--color-white");
			const marine = couleur("--color-navy");
			const marineProfond = couleur("--color-navy-deep");
			const bleu = couleur("--color-blue");
			const fuchsia = couleur("--color-crimson");
			const or = couleur("--color-or");

			// Fond : dégradé marine, bande diagonale fuchsia, grande silhouette en motif.
			const fond = ctx.createLinearGradient(0, 0, 0, H);
			fond.addColorStop(0, marine);
			fond.addColorStop(1, marineProfond);
			ctx.fillStyle = fond;
			ctx.fillRect(0, 0, W, H);
			ctx.save();
			ctx.globalAlpha = 0.9;
			ctx.fillStyle = bleu;
			ctx.beginPath();
			ctx.moveTo(W * 0.55, 0);
			ctx.lineTo(W, 0);
			ctx.lineTo(W, H * 0.35);
			ctx.closePath();
			ctx.fill();
			ctx.restore();
			ctx.save();
			ctx.globalAlpha = 0.08;
			const tailleMotif = H * 0.95;
			ctx.drawImage(imgSilhouette, W - tailleMotif * 0.78, H * 0.08, tailleMotif, tailleMotif);
			ctx.restore();

			// En-tête : logo du club, saison en cours.
			ctx.drawImage(imgLogo, 70, 50, 130, 130);
			ctx.font = police(34, 700);
			ctx.textAlign = "right";
			ctx.textBaseline = "middle";
			ctx.fillStyle = blanc;
			ctx.fillText(`SAISON ${saison}`, W - 70, 115);

			// Photo (ou emplacement vide).
			const c = cadrePhoto(W, H);
			ctx.save();
			arrondi(c.x, c.y, c.l, c.h, 36);
			ctx.clip();
			ctx.fillStyle = marineProfond;
			ctx.fillRect(c.x, c.y, c.l, c.h);
			if (photo) {
				const echelle = Math.max(c.l / photo.width, c.h / photo.height) * Number(champZoom.value);
				const l = photo.width * echelle;
				const h = photo.height * echelle;
				ctx.drawImage(photo, c.x + (c.l - l) / 2 + decalage.x, c.y + (c.h - h) / 2 + decalage.y, l, h);
			} else {
				ctx.globalAlpha = 0.35;
				const t = c.h * 0.8;
				ctx.drawImage(imgSilhouette, c.x + (c.l - t) / 2, c.y + c.h * 0.1, t, t);
				ctx.globalAlpha = 1;
			}
			ctx.restore();
			ctx.lineWidth = 10;
			ctx.strokeStyle = blanc;
			arrondi(c.x, c.y, c.l, c.h, 36);
			ctx.stroke();

			// Badge doré : détenteur d'un record individuel sur /records.
			if (joueur.record) {
				const bx = c.x + c.l - 20;
				const by = c.y + 20;
				ctx.fillStyle = or;
				ctx.beginPath();
				ctx.arc(bx, by, 82, 0, Math.PI * 2);
				ctx.fill();
				ctx.lineWidth = 6;
				ctx.strokeStyle = blanc;
				ctx.stroke();
				ctx.fillStyle = marineProfond;
				ctx.textAlign = "center";
				ctx.font = police(46, 900);
				ctx.fillText("★", bx, by - 16);
				ctx.font = police(24, 900);
				ctx.fillText("RECORD", bx, by + 26);
			}

			// Bandeau du nom (légèrement incliné), équipe et poste.
			const bandeauY = c.y + c.h - 30;
			ctx.fillStyle = fuchsia;
			ctx.beginPath();
			ctx.moveTo(40, bandeauY + 14);
			ctx.lineTo(W - 40, bandeauY);
			ctx.lineTo(W - 40, bandeauY + 126);
			ctx.lineTo(40, bandeauY + 140);
			ctx.closePath();
			ctx.fill();
			const nom = champSurnom.value.trim() || joueur.nom;
			ctx.fillStyle = blanc;
			ctx.textAlign = "center";
			texteAjuste(nom.toUpperCase(), W - 160, 84);
			ctx.fillText(nom.toUpperCase(), W / 2, bandeauY + 72);

			const poste = champPoste.value;
			ctx.font = police(40, 700);
			const ligne = poste ? `${joueur.equipe}  ·  ${poste}` : joueur.equipe;
			texteAjuste(ligne, W - 160, 40, 700);
			ctx.fillText(ligne, W / 2, bandeauY + 200);

			// Pastilles de statistiques, selon la bascule de la page au moment
			// de la génération ; arrêts à la place des buts pour un gardien
			// (choix explicite du poste, jamais déduit des chiffres).
			const vueSaison = document.querySelector(".carriere-content")?.getAttribute("data-vue") === "saison";
			const s = vueSaison ? joueur.saison : joueur.carriere;
			const gardien = poste === "Gardien";
			const pastilles = [
				{ valeur: s.matchs, libelle: "MATCHS" },
				gardien ? { valeur: s.arrets, libelle: "ARRÊTS" } : { valeur: s.buts, libelle: "BUTS" },
			];
			const pastilleY = bandeauY + (H > 1500 ? 420 : 340);
			pastilles.forEach((p, i) => {
				const x = W / 2 + (i === 0 ? -170 : 170);
				ctx.fillStyle = blanc;
				ctx.beginPath();
				ctx.arc(x, pastilleY, 110, 0, Math.PI * 2);
				ctx.fill();
				ctx.lineWidth = 8;
				ctx.strokeStyle = fuchsia;
				ctx.stroke();
				ctx.fillStyle = marineProfond;
				ctx.textAlign = "center";
				texteAjuste(String(p.valeur), 170, 86, 900);
				ctx.fillText(String(p.valeur), x, pastilleY - 12);
				ctx.font = police(26, 800);
				ctx.fillText(p.libelle, x, pastilleY + 52);
			});

			// Période couverte, toujours explicite -- jamais "carrière" seul
			// (un total sur une image qui circule hors contexte serait faux pour
			// quelqu'un au club depuis bien plus longtemps que nos données).
			ctx.fillStyle = blanc;
			ctx.globalAlpha = 0.85;
			ctx.font = police(28, 500);
			ctx.textAlign = "center";
			const periode = vueSaison ? `Statistiques de la saison ${saison}` : `Cumul des feuilles de match disponibles, ${debut} à ${saison}`;
			ctx.fillText(periode, W / 2, H - 92);
			ctx.globalAlpha = 1;
			// Toujours présente, jamais optionnelle (voir l'en-tête du fichier).
			ctx.font = police(26, 800);
			ctx.fillText("CARTE PERSONNELLE, NON OFFICIELLE", W / 2, H - 44);
		}

		function ouvrir(donnees: Joueur) {
			// Par précaution : le bouton n'existe que pour un affichage nominatif.
			if (!donnees.nominatif) return;
			joueur = donnees;
			photo = null;
			if (urlPhoto) URL.revokeObjectURL(urlPhoto);
			urlPhoto = null;
			decalage = { x: 0, y: 0 };
			champPhoto.value = "";
			champZoom.value = "1";
			cadrage.disabled = true;
			champSurnom.value = "";
			champPoste.value = "";
			dialog!.querySelector<HTMLInputElement>('input[name="carte-format"][value="1350"]')!.checked = true;
			canvas.height = 1350;
			dialog!.showModal();
			void dessiner();
		}

		// Boutons "Créer ma carte" du tableau (voir statistiques-carriere.astro).
		// Phase de capture : le clic ne doit pas aussi ouvrir/fermer la fiche
		// détaillée, déclenchée par un clic sur toute la ligne.
		document.addEventListener(
			"click",
			(e) => {
				const bouton = (e.target as HTMLElement).closest<HTMLButtonElement>(".btn-carte");
				if (!bouton) return;
				e.stopPropagation();
				ouvrir(JSON.parse(bouton.dataset.carte!));
			},
			true,
		);

		champPhoto.addEventListener("change", async () => {
			const fichier = champPhoto.files?.[0];
			if (!fichier) return;
			if (urlPhoto) URL.revokeObjectURL(urlPhoto);
			// URL locale (blob:) : l'image ne quitte jamais l'appareil.
			urlPhoto = URL.createObjectURL(fichier);
			photo = await charger(urlPhoto);
			decalage = { x: 0, y: 0 };
			champZoom.value = "1";
			cadrage.disabled = false;
			void dessiner();
		});
		champZoom.addEventListener("input", () => void dessiner());
		champSurnom.addEventListener("input", () => void dessiner());
		champPoste.addEventListener("change", () => void dessiner());
		for (const b of dialog.querySelectorAll<HTMLButtonElement>(".carte-fleches [data-dx]")) {
			b.addEventListener("click", () => {
				decalage.x += Number(b.dataset.dx) * 30;
				decalage.y += Number(b.dataset.dy) * 30;
				void dessiner();
			});
		}
		dialog.querySelector(".carte-recentrer")!.addEventListener("click", () => {
			decalage = { x: 0, y: 0 };
			champZoom.value = "1";
			void dessiner();
		});
		for (const radio of dialog.querySelectorAll<HTMLInputElement>('input[name="carte-format"]')) {
			radio.addEventListener("change", () => {
				canvas.height = Number(radio.value);
				void dessiner();
			});
		}

		// Déplacement au doigt ou à la souris, dans l'aperçu.
		let glisse: { x: number; y: number } | null = null;
		canvas.addEventListener("pointerdown", (e) => {
			if (!photo) return;
			glisse = { x: e.clientX, y: e.clientY };
			canvas.setPointerCapture(e.pointerId);
		});
		canvas.addEventListener("pointermove", (e) => {
			if (!glisse) return;
			const ratio = canvas.width / canvas.getBoundingClientRect().width;
			decalage.x += (e.clientX - glisse.x) * ratio;
			decalage.y += (e.clientY - glisse.y) * ratio;
			glisse = { x: e.clientX, y: e.clientY };
			void dessiner();
		});
		canvas.addEventListener("pointerup", () => (glisse = null));
		canvas.addEventListener("pointercancel", () => (glisse = null));

		const fichierCarte = () =>
			new Promise<File>((ok) =>
				canvas.toBlob((blob) => ok(new File([blob!], `carte-hbi-${(joueur?.nom ?? "joueur").toLowerCase().replace(/[^a-z0-9]+/gi, "-")}.png`, { type: "image/png" })), "image/png"),
			);

		// Partage natif avec fichier quand le navigateur le permet (surtout
		// mobile), sinon simple téléchargement.
		const partagePossible = () => typeof navigator.canShare === "function" && navigator.canShare({ files: [new File([""], "test.png", { type: "image/png" })] });
		boutonPartager.hidden = !partagePossible();
		boutonPartager.addEventListener("click", async () => {
			const fichier = await fichierCarte();
			try {
				await navigator.share({ files: [fichier], title: "Carte joueur HBI" });
			} catch {
				// Partage annulé par la personne : rien à faire.
			}
		});
		boutonTelecharger.addEventListener("click", async () => {
			const fichier = await fichierCarte();
			const url = URL.createObjectURL(fichier);
			const a = document.createElement("a");
			a.href = url;
			a.download = fichier.name;
			a.click();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		});

		// À la fermeture, rien ne subsiste de la photo.
		dialog.addEventListener("close", () => {
			if (urlPhoto) URL.revokeObjectURL(urlPhoto);
			urlPhoto = null;
			photo = null;
			champPhoto.value = "";
			champSurnom.value = "";
		});
	}
</script>

<style>
	.carte-dialog {
		width: min(960px, calc(100vw - 2rem));
		max-height: calc(100vh - 2rem);
		overflow: auto;
		padding: 1.25rem;
		border: 0;
		border-radius: 8px;
		background: var(--color-navy-deep);
		color: var(--color-white);
	}
	.carte-dialog::backdrop {
		background: color-mix(in srgb, var(--color-navy-deep) 80%, transparent);
	}
	.carte-dialog h2 {
		margin: 0 0 1rem;
		font-size: 1.4rem;
	}
	.carte-fermer-form {
		position: sticky;
		top: 0;
		float: right;
	}
	.carte-fermer {
		min-width: 44px;
		min-height: 44px;
		font-size: 1.6rem;
		color: var(--color-white);
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--color-white) 30%, transparent);
		border-radius: 4px;
		cursor: pointer;
	}
	.carte-grille {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1.5rem;
	}
	@media (max-width: 700px) {
		.carte-grille {
			grid-template-columns: 1fr;
		}
	}
	.carte-apercu canvas {
		display: block;
		width: 100%;
		max-width: 420px;
		height: auto;
		margin: 0 auto;
		border-radius: 8px;
		touch-action: none;
		cursor: grab;
	}
	.carte-aide,
	.carte-note,
	.carte-confidentialite {
		font-size: 0.85rem;
		color: color-mix(in srgb, var(--color-white) 75%, transparent);
		margin: 0.35rem 0 0.9rem;
	}
	.carte-confidentialite {
		color: var(--color-white);
		font-weight: 700;
	}
	.carte-label {
		display: block;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0.6rem 0 0.35rem;
		padding: 0;
	}
	.carte-sous-label {
		font-size: 0.85rem;
	}
	.carte-reglages input[type="text"],
	.carte-reglages select,
	.carte-reglages input[type="file"] {
		width: 100%;
		box-sizing: border-box;
		min-height: 44px;
		padding: 0.5rem 0.7rem;
		font-size: 1rem;
		border-radius: 4px;
		border: 1px solid color-mix(in srgb, var(--color-white) 30%, transparent);
		background: var(--color-navy);
		color: var(--color-white);
	}
	.carte-reglages input:disabled {
		opacity: 0.5;
	}
	.carte-reglages input[type="range"] {
		width: 100%;
		min-height: 44px;
	}
	fieldset {
		border: 0;
		margin: 0;
		padding: 0;
	}
	.carte-fleches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.carte-fleches button,
	.carte-actions button {
		min-width: 44px;
		min-height: 44px;
		padding: 0.4rem 0.8rem;
		font: inherit;
		font-size: 1rem;
