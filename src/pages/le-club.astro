---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Favicon from "../components/Favicon.astro";

const page = await getEntry("leClub", "page");
const { data } = page!;

const histoireIntroParagraphes = data.histoireIntro.trim().split(/\n\s*\n/);
const histoireConclusionParagraphes = data.histoireConclusion.trim().split(/\n\s*\n/);
const parrainParagraphes = data.parrainTexte.trim().split(/\n\s*\n/);

const moments = (await getCollection("histoireClub")).sort((a, b) => a.data.ordre - b.data.ordre);
const telephoneHref = `tel:${data.telephone.replace(/\s+/g, "")}`;
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Le club — Handball Islois</title>
		<meta
			name="description"
			content="L'histoire du Handball Islois, sa présidente, sa devise, son parrain Hugo Brouzet, et toutes les infos pratiques du club à L'Isle-sur-la-Sorgue."
		/>
	</head>
	<body>
		<Header />
		<PageBanner
			title="Le club"
			subtitle="Depuis 1977, le handball islois se construit dans l'esprit de famille."
		/>

		<section class="histoire">
			<div class="wrap">
				<h2>Notre histoire</h2>
				{histoireIntroParagraphes.map((paragraphe) => <p>{paragraphe}</p>)}
				<p class="devise">« {data.devise} »</p>
				{histoireConclusionParagraphes.map((paragraphe) => <p>{paragraphe}</p>)}
			</div>
		</section>

		<section class="parrain">
			<div class="wrap">
				<div class="photo">
					<Image src={data.parrainPhoto} alt={data.parrainPhotoAlt} width={400} loading="lazy" />
				</div>
				<div class="content">
					<span class="kicker">Notre parrain</span>
					<h2>{data.parrainNom}</h2>
					{parrainParagraphes.map((paragraphe) => <p>{paragraphe}</p>)}
				</div>
			</div>
		</section>

		{
			moments.length > 0 && (
				<section class="moments">
					<div class="wrap">
						<h2>Ils ont marqué le club</h2>
						<div class="moments-list">
							{moments.map((moment) => (
								<article class="moment">
									{moment.data.photo && (
										<div class="moment-photo">
											<Image src={moment.data.photo} alt={moment.data.photoAlt ?? ""} width={300} loading="lazy" />
										</div>
									)}
									<div class="moment-body">
										<p class="periode">{moment.data.periode}</p>
										<h3>{moment.data.titre}</h3>
										<p>{moment.data.texte}</p>
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			)
		}

		<section class="pratique">
			<div class="wrap">
				<h2>Infos pratiques</h2>
				<div class="grid">
					<div class="card">
						<h3>Lieu d&rsquo;entraînement</h3>
						<p>{data.lieuNom}</p>
						<p>{data.lieuAdresse}</p>
					</div>
					<div class="card">
						<h3>Contact</h3>
						<p><a href={telephoneHref}>{data.telephone}</a></p>
						<p><a href={`mailto:${data.email}`}>{data.email}</a></p>
					</div>
					<div class="card">
						<h3>Réseaux</h3>
						<p>
							<a href={data.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram&nbsp;: @handball_islois</a>
						</p>
						<p>
							<a href={data.facebookUrl} target="_blank" rel="noopener noreferrer">Facebook&nbsp;: Handball Islois</a>
						</p>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
</style>

<style>
	h2 {
		color: var(--color-navy-deep);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		margin: 0 0 1.25rem;
	}
	h2::after {
		content: "";
		display: block;
		width: 56px;
		height: 4px;
		margin: 0.75rem auto 0;
		background: var(--color-crimson);
		border-radius: 2px;
	}

	.histoire {
		background: var(--color-white);
		padding: 3.5rem 1.5rem;
	}
	.histoire .wrap {
		max-width: 680px;
		margin: 0 auto;
		text-align: center;
	}
	.histoire p {
		color: var(--color-navy-deep);
		font-size: 1.05rem;
		line-height: 1.6;
		margin: 0 0 1rem;
	}
	.histoire .devise {
		font-weight: 800;
		font-style: italic;
		color: var(--color-blue);
		font-size: 1.15rem;
	}

	.parrain {
		background: var(--color-navy);
		padding: 3.5rem 1.5rem;
	}
	.parrain .wrap {
		max-width: 900px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(180px, 260px) 1fr;
		gap: 2.5rem;
		align-items: center;
	}
	.parrain .photo {
		aspect-ratio: 4 / 5;
		border-radius: 16px;
		overflow: hidden;
		background: var(--color-navy-deep);
	}
	.parrain .photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.parrain .kicker {
		display: inline-block;
		color: var(--color-crimson);
		font-weight: 800;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}
	.parrain h2 {
		color: var(--color-white);
		text-align: left;
	}
	.parrain h2::after {
		margin-left: 0;
	}
	.parrain .content p {
		color: rgba(255, 255, 255, 0.85);
		font-size: 1.02rem;
		line-height: 1.6;
		margin: 0 0 0.85rem;
	}

	.moments {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.moments h2 {
		color: var(--color-white);
		text-align: center;
	}
	.moments h2::after {
		margin: 0.75rem auto 0;
	}
	.moments-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.moment {
		background: var(--color-navy);
		border-top: 3px solid var(--color-crimson);
	}
	.moment-photo {
		max-height: 260px;
		overflow: hidden;
		background: var(--color-navy-deep);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.moment-photo :global(img) {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 260px;
		object-fit: contain;
	}
	.moment-body {
		padding: 1.25rem 1.4rem 1.5rem;
	}
	.moment .periode {
		color: var(--color-crimson);
		font-weight: 800;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 0.4rem;
	}
	.moment h3 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		margin: 0 0 0.6rem;
	}
	.moment p:not(.periode) {
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.95rem;
		line-height: 1.55;
		margin: 0;
	}

	.pratique {
		background: var(--color-white);
		padding: 3.5rem 1.5rem;
	}
	.pratique .wrap {
		max-width: 1000px;
		margin: 0 auto;
		text-align: center;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
		text-align: left;
	}
	.card {
		background: var(--color-navy-deep);
		padding: 1.5rem;
		border-top: 3px solid var(--color-crimson);
	}
	.card h3 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.05rem;
		margin: 0 0 0.75rem;
	}
	.card p {
		color: rgba(255, 255, 255, 0.8);
		font-size: 1rem;
		line-height: 1.6;
		margin: 0 0 0.3rem;
	}
	.card a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
	}
	.card a:hover {
		color: var(--color-crimson);
	}

	@media (max-width: 640px) {
		.parrain .wrap {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			text-align: center;
		}
		.parrain .photo {
			max-width: 220px;
			margin: 0 auto;
		}
		.parrain h2 {
			text-align: center;
		}
		.parrain h2::after {
			margin: 0.75rem auto 0;
		}
	}
</style>
