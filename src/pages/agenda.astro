---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import AjouterAgendaButton from "../components/AjouterAgendaButton.astro";
import Favicon from "../components/Favicon.astro";
import { withBase } from "../utils/links";
import { getAgendaMatches, getAgendaTeams, getCompetitionLinks, formatMatchDate, formatMatchTime } from "../lib/agenda";
import { getUpcomingEvenements } from "../lib/evenements";

// Matchs (flux FFHandball) et événements du club (CMS) dans UNE seule liste
// chronologique : la personne qui consulte l'agenda cherche "ce qui vient",
// pas "quel type de chose vient" -- deux blocs séparés l'obligeraient à
// faire elle-même la fusion dans sa tête.
const [matches, evenements] = await Promise.all([getAgendaMatches(), getUpcomingEvenements()]);
const entries = [
	...matches.map((match) => ({ kind: "match" as const, start: match.start, match })),
	...evenements.map((evenement) => ({ kind: "evenement" as const, start: evenement.start, evenement })),
].sort((a, b) => a.start.getTime() - b.start.getTime());
const competitions = await getCompetitionLinks();
const agendaTeams = await getAgendaTeams();
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Agenda — Handball Islois</title>
		<meta
			name="description"
			content="Tous les prochains matchs et événements du Handball Islois, toutes équipes confondues : dates, horaires, lieux, et liens pour ajouter le calendrier officiel FFHandball à votre agenda."
		/>
	</head>
	<body>
		<Header />
		<PageBanner
			title="Agenda"
			subtitle="Tous les prochains matchs et événements du HBI, toutes équipes confondues, à partir des calendriers officiels FFHandball."
		/>

		<section class="matches">
			<div class="wrap">
				<h2>À venir</h2>
				{entries.length === 0 && <p class="empty">Aucun match ni événement à venir pour le moment.</p>}
				<ul class="match-list">
					{
						entries.map((entry) =>
							entry.kind === "evenement" ? (
								<li class="match-card event-card">
									<div class="match-top">
										<span class="event-title">{entry.evenement.titre}</span>
										<span class="badge badge--event">Événement du club</span>
									</div>
									<p class="event-meta">
										{formatMatchDate(entry.start)} à {formatMatchTime(entry.start)}
									</p>
									{entry.evenement.lieu && <p class="event-meta">{entry.evenement.lieu}</p>}
									{entry.evenement.description && <p class="event-desc">{entry.evenement.description}</p>}
									{entry.evenement.lien && (
										<a class="event-link" href={entry.evenement.lien} target="_blank" rel="noopener noreferrer">
											Plus d&rsquo;infos →
										</a>
									)}
								</li>
							) : (
								<li class={`match-card ${entry.match.isHome ? "match-card--home" : ""}`}>
									<div class="match-top">
										<span class="team">{entry.match.teamLabel}</span>
										<span class="badges">
											{entry.match.reporte && <span class="badge badge--reporte">Reporté</span>}
											<span class={`badge ${entry.match.isHome ? "badge--home" : "badge--away"}`}>
												{entry.match.isHome ? "Domicile" : "Extérieur"}
											</span>
										</span>
									</div>
									<p class="opponent">{entry.match.isDerby ? "Derby interne au club" : `vs ${entry.match.opponent}`}</p>
									{entry.match.reporte ? (
										<>
											<p class="meta meta--reporte">
												{entry.match.reporte.nouvelleDate
													? `Nouvelle date : ${formatMatchDate(entry.match.reporte.nouvelleDate).toLowerCase()} à ${formatMatchTime(entry.match.reporte.nouvelleDate)}`
													: "Nouvelle date à venir"}
											</p>
											<p class="meta meta--origine">Initialement prévu le {formatMatchDate(entry.match.reporte.dateOrigine).toLowerCase()}</p>
										</>
									) : (
										<>
											<p class="meta">
												{formatMatchDate(entry.start)} à {formatMatchTime(entry.start)}
											</p>
											<p class="meta meta--location">{entry.match.location}</p>
										</>
									)}
								</li>
							),
						)
					}
				</ul>
			</div>
		</section>

		{
			agendaTeams.length > 0 && (
				<section class="subscribe">
					<div class="wrap">
						<h2>S&rsquo;abonner à l&rsquo;agenda d&rsquo;une équipe</h2>
						<p class="intro">
							Chaque bouton pointe directement vers le flux officiel FFHandball de
							l&rsquo;équipe&nbsp;: ajoutez-le à Google Agenda, Apple Calendrier ou
							Outlook pour ne manquer aucun match.
						</p>
						<div class="buttons">
							{agendaTeams.map((t) => (
								<AjouterAgendaButton href={t.urlIcs} label={`${t.nomAffiche} →`} />
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			competitions.length > 0 && (
				<section class="classements">
					<div class="wrap">
						<h2>Classements</h2>
						<ul class="classement-list">
							{competitions.map((c) => (
								<li>
									<a href={c.classementUrl} target="_blank" rel="noopener noreferrer">
										Voir le classement — {c.label} →
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
</style>

<style>
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		text-align: center;
		margin: 0 0 0.75rem;
	}
	.wrap {
		max-width: 900px;
		margin: 0 auto;
	}

	.subscribe {
		background: var(--color-navy);
		padding: 3rem 1.5rem;
	}
	.subscribe .intro {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
		max-width: 560px;
		margin: 0 auto 1.75rem;
		line-height: 1.6;
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.matches {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.empty {
		color: rgba(255, 255, 255, 0.7);
		text-align: center;
	}
	.match-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	.match-card {
		background: var(--color-blue);
		border-left: 4px solid transparent;
		padding: 1.1rem 1.4rem;
	}
	.match-card--home {
		border-left-color: var(--color-crimson);
		background: var(--color-navy);
	}
	.match-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.4rem;
	}
	.team {
		color: var(--color-white);
		font-weight: 800;
		font-size: 1.05rem;
	}
	.badge {
		display: inline-block;
		font-weight: 800;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
	}
	.badges {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.badge--home {
		background: var(--color-crimson);
		color: var(--color-white);
	}
	/* Blanc sur fond bleu/marine : le seul badge "plein" clair de la liste,
	   donc visible d'un coup d'œil, sans entrer en concurrence avec le crimson
	   du domicile (les deux badges peuvent se côtoyer sur une même carte). */
	.badge--reporte {
		background: var(--color-white);
		color: var(--color-crimson);
	}
	.meta--reporte {
		color: var(--color-white);
		font-weight: 700;
	}
	.meta--origine {
		text-decoration: line-through;
	}
	.badge--away {
		background: rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.85);
	}
	/* Événement du club : carte BLANCHE, seule de la liste à ne pas être sur
	   fond bleu/marine -- se repère au premier coup d'œil, sans nouvelle
	   couleur. Le crimson reste réservé aux matchs à domicile, le bleu de
	   marque sert ici de liseré et le marine de texte/badge (contraste
	   largement > AA sur blanc). */
	.event-card {
		background: var(--color-white);
		border-left-color: var(--color-blue);
	}
	.event-title {
		color: var(--color-navy-deep);
		font-weight: 800;
		font-size: 1.05rem;
	}
	.badge--event {
		background: var(--color-navy);
		color: var(--color-white);
	}
	.event-meta {
		color: var(--color-navy);
		font-size: 0.9rem;
		margin: 0;
	}
	.event-desc {
		color: var(--color-navy-deep);
		font-size: 1rem;
		line-height: 1.5;
		margin: 0.6rem 0 0;
		white-space: pre-line;
	}
	.event-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-top: 0.4rem;
		color: var(--color-navy);
		font-weight: 800;
		text-decoration: none;
		border-bottom: 2px solid var(--color-crimson);
	}
	.event-link:hover {
		color: var(--color-crimson);
	}
	.opponent {
		color: var(--color-white);
		font-size: 1rem;
		margin: 0 0 0.4rem;
	}
	.meta {
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.9rem;
		margin: 0;
	}

	/* Suit directement le bloc "S'abonner" (même fond marine) : un filet les
	   sépare pour qu'ils ne se lisent pas comme une seule section. */
	.classements {
		background: var(--color-navy);
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding: 3rem 1.5rem 3.5rem;
	}
	.classement-list {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}
	.classement-list a {
		color: var(--color-white);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 2px solid var(--color-crimson);
		padding-bottom: 0.1rem;
	}
	.classement-list a:hover {
		color: var(--color-crimson);
	}
</style>
