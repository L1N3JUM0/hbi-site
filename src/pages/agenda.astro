---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import AjouterAgendaButton from "../components/AjouterAgendaButton.astro";
import Favicon from "../components/Favicon.astro";
import { withBase } from "../utils/links";
import { getAgendaMatches, getAgendaTeams, getCompetitionLinks, formatMatchDate, formatMatchTime } from "../lib/agenda";

const matches = await getAgendaMatches();
const competitions = await getCompetitionLinks();
const agendaTeams = await getAgendaTeams();
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Agenda — Handball Islois</title>
		<meta
			name="description"
			content="Tous les prochains matchs du Handball Islois, toutes équipes confondues : dates, horaires, lieux, et liens pour ajouter le calendrier officiel FFHandball à votre agenda."
		/>
	</head>
	<body>
		<Header />
		<PageBanner
			title="Agenda"
			subtitle="Tous les prochains matchs du HBI, toutes équipes confondues, à partir des calendriers officiels FFHandball."
		/>

		{
			agendaTeams.length > 0 && (
				<section class="subscribe">
					<div class="wrap">
						<h2>S&rsquo;abonner à l&rsquo;agenda d&rsquo;une équipe</h2>
						<p class="intro">
							Chaque bouton pointe directement vers le flux officiel FFHandball de
							l&rsquo;équipe&nbsp;: ajoutez-le à Google Agenda, Apple Calendrier ou
							Outlook pour ne manquer aucun match.
						</p>
						<div class="buttons">
							{agendaTeams.map((t) => (
								<AjouterAgendaButton href={t.urlIcs} label={`${t.nomAffiche} →`} />
							))}
						</div>
					</div>
				</section>
			)
		}

		<section class="matches">
			<div class="wrap">
				<h2>Prochains matchs</h2>
				{matches.length === 0 && <p class="empty">Aucun match à venir pour le moment.</p>}
				<ul class="match-list">
					{
						matches.map((m) => (
							<li class={`match-card ${m.isHome ? "match-card--home" : ""}`}>
								<div class="match-top">
									<span class="team">{m.teamLabel}</span>
									<span class={`badge ${m.isHome ? "badge--home" : "badge--away"}`}>
										{m.isHome ? "Domicile" : "Extérieur"}
									</span>
								</div>
								<p class="opponent">{m.isDerby ? "Derby interne au club" : `vs ${m.opponent}`}</p>
								<p class="meta">
									{formatMatchDate(m.start)} à {formatMatchTime(m.start)}
								</p>
								<p class="meta meta--location">{m.location}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		{
			competitions.length > 0 && (
				<section class="classements">
					<div class="wrap">
						<h2>Classements</h2>
						<ul class="classement-list">
							{competitions.map((c) => (
								<li>
									<a href={c.classementUrl} target="_blank" rel="noopener noreferrer">
										Voir le classement — {c.label} →
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)
		}

		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
</style>

<style>
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		text-align: center;
		margin: 0 0 0.75rem;
	}
	.wrap {
		max-width: 900px;
		margin: 0 auto;
	}

	.subscribe {
		background: var(--color-navy);
		padding: 3rem 1.5rem;
	}
	.subscribe .intro {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
		max-width: 560px;
		margin: 0 auto 1.75rem;
		line-height: 1.6;
	}
	.buttons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.matches {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.empty {
		color: rgba(255, 255, 255, 0.7);
		text-align: center;
	}
	.match-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	.match-card {
		background: var(--color-blue);
		border-left: 4px solid transparent;
		padding: 1.1rem 1.4rem;
	}
	.match-card--home {
		border-left-color: var(--color-crimson);
		background: var(--color-navy);
	}
	.match-top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.4rem;
	}
	.team {
		color: var(--color-white);
		font-weight: 800;
		font-size: 1.05rem;
	}
	.badge {
		display: inline-block;
		font-weight: 800;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
	}
	.badge--home {
		background: var(--color-crimson);
		color: var(--color-white);
	}
	.badge--away {
		background: rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.85);
	}
	.opponent {
		color: var(--color-white);
		font-size: 1rem;
		margin: 0 0 0.4rem;
	}
	.meta {
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.9rem;
		margin: 0;
	}

	.classements {
		background: var(--color-navy);
		padding: 3rem 1.5rem 3.5rem;
	}
	.classement-list {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}
	.classement-list a {
		color: var(--color-white);
		font-weight: 700;
		text-decoration: none;
		border-bottom: 2px solid var(--color-crimson);
		padding-bottom: 0.1rem;
	}
	.classement-list a:hover {
		color: var(--color-crimson);
	}
</style>
