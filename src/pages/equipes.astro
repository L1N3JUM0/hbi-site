---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import ResultatsEquipe from "../components/resultats/ResultatsEquipe.astro";
import FicheEquipe from "../components/equipes/FicheEquipe.astro";
import Favicon from "../components/Favicon.astro";
import { withBase } from "../utils/links";
import { getCollection, type CollectionEntry } from "astro:content";
import { getAgendaTeams, getMatchesForEquipe } from "../lib/agenda";
import { saisonActuelle } from "../lib/saison";
import { trierEquipes } from "../lib/equipes";
import { getResultatsForEquipe, resultatsParSaison } from "../lib/resultats";
import { slugsAvecResultats } from "../lib/statistiques";

const allTeams = trierEquipes(await getCollection("equipes"));
const actives = allTeams.filter((t) => t.data.statut !== "archivee");
const competition = actives.filter((t) => t.data.type === "competition");
const decouverte = actives.filter((t) => t.data.type === "decouverte" || t.data.type === "inclusion");
const transversal = actives.find((t) => t.data.type === "transversal");
/** Équipes qui ont cessé de jouer (dissoutes, catégorie non reconduite...) :
 * plus affichées dans l'effectif, mais leurs résultats passés doivent rester
 * consultables -- voir GUIDE-EDITION.md, section "Changement de saison". */
const archivees = allTeams.filter((t) => t.data.statut === "archivee");

const agendaTeams = await getAgendaTeams();
/** Équipes ayant au moins un résultat importé (voir src/lib/statistiques.ts) :
 * seules celles-ci reçoivent les liens vers /statistiques et
 * /statistiques-carriere. Ces pages restent volontairement hors du menu de
 * navigation et non indexées : destinées aux joueurs, coachs et dirigeants,
 * pas mises en avant auprès du grand public. */
const slugsStats = await slugsAvecResultats();

const typeLabel: Record<string, string> = {
	decouverte: "Découverte",
	inclusion: "Inclusion",
};

/** Prochains matchs listés dans le détail d'une fiche (la suite est sur
 * /agenda?equipe=<slug>). */
const PROCHAINS_MATCHS = 6;
/** Derniers résultats de la saison en cours affichés à côté. */
const DERNIERS_RESULTATS = 3;

async function ficheProps(t: CollectionEntry<"equipes">) {
	const slug = t.data.slug;
	const calendriers = agendaTeams.filter((a) => a.equipeSlug === slug);
	const resultats = await getResultatsForEquipe(slug);
	return {
		equipe: t,
		calendriers,
		matchs: calendriers.length > 0 ? await getMatchesForEquipe(slug, PROCHAINS_MATCHS) : [],
		derniers: resultatsParSaison(resultats).saisonEnCours.slice(0, DERNIERS_RESULTATS),
		aDesResultats: resultats.length > 0,
		avecStats: slugsStats.has(slug),
		tag: typeLabel[t.data.type],
	};
}

const fichesCompetition = await Promise.all(competition.map(ficheProps));
const fichesDecouverte = await Promise.all(decouverte.map(ficheProps));
const ficheTransversal = transversal ? await ficheProps(transversal) : null;
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Nos équipes — Handball Islois</title>
		<meta
			name="description"
			content="L'effectif complet du Handball Islois : jours, horaires, encadrants et tarifs, du baby hand aux seniors, ainsi que Handensemble et le créneau étirements/renforcement."
		/>
	</head>
	<body>
		<Header />
		<PageBanner
			title="Nos équipes"
			subtitle={`Du baby hand aux seniors, en passant par le handball adapté : l'effectif complet du HBI pour la saison ${saisonActuelle()}, entraînements au COSEC Émile Avy.`}
		/>

		<section class="teams">
			<div class="wrap">
				<h2>Équipes de compétition</h2>
				<div class="fiches">
					{fichesCompetition.map((f) => <FicheEquipe {...f} />)}
				</div>
			</div>
		</section>

		<section class="decouverte">
			<div class="wrap">
				<h2>Découverte &amp; inclusion</h2>
				<p class="intro">
					Deux créneaux ouverts à tous, pensés pour découvrir le handball sans
					enjeu de compétition.
				</p>
				<div class="fiches">
					{fichesDecouverte.map((f) => <FicheEquipe {...f} />)}
				</div>
			</div>
		</section>

		{
			ficheTransversal && (
				<section class="transversal">
					<div class="wrap">
						<h2>Créneau transversal</h2>
						<div class="fiches">
							<FicheEquipe {...ficheTransversal} />
						</div>
					</div>
				</section>
			)
		}

		{
			archivees.length > 0 && (
				<section class="archives">
					<div class="wrap">
						<details class="archives-details">
							<summary>Équipes des saisons passées ({archivees.length})</summary>
							<div class="archives-grid">
								{archivees.map((t) => (
									<div class="card card--archivee" id={t.data.slug}>
										<h3>{t.data.nom}</h3>
										<ResultatsEquipe equipeSlug={t.data.slug} affichageStats={t.data.affichageStats} calendriers={t.data.calendriers} />
										{slugsStats.has(t.data.slug) && (
											<div class="stats-links">
												<a class="stats-link" href={withBase(`/statistiques#equipe-${t.data.slug}`)}>
													Statistiques de la saison →
												</a>
												<a class="stats-link" href={withBase(`/statistiques-carriere#equipe-${t.data.slug}`)}>
													Statistiques carrière →
												</a>
											</div>
										)}
									</div>
								))}
							</div>
						</details>
					</div>
				</section>
			)
		}

		<Footer />
	</body>
</html>

<script>
	// Léger défilement/mise en évidence quand on arrive via une ancre
	// (#slug) depuis la homepage.
	const id = window.location.hash.replace("#", "");
	if (id) {
		const target = document.getElementById(id);
		if (target) {
			target.classList.add("just-arrived");
			target.addEventListener("animationend", () => target.classList.remove("just-arrived"), { once: true });
		}
	}
</script>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>

<style>
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		text-align: center;
		margin: 0 0 2rem;
	}
	.decouverte h2 {
		margin-bottom: 0.75rem;
	}
	.intro {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
		max-width: 560px;
		margin: 0 auto 2rem;
		line-height: 1.6;
	}
	.teams,
	.transversal {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.decouverte {
		background: var(--color-navy-deep);
		padding: 0 1.5rem 3.5rem;
	}
	.wrap {
		max-width: 1000px;
		margin: 0 auto;
	}
	.fiches {
		display: grid;
		gap: 0.6rem;
	}

	/* Cartes des équipes archivées (inchangées). */
	.card {
		padding: 1.25rem 1.4rem;
		scroll-margin-top: 5rem;
		border-radius: 4px;
	}
	.card h3 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0 0 0.75rem;
	}
	/* Volontairement discret (voir le commentaire sur slugsStats plus haut) :
	 * pas des boutons, deux simples lignes de texte en bas de carte. */
	.stats-links {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.75rem;
	}
	.stats-link {
		display: block;
		color: rgba(255, 255, 255, 0.45);
		font-size: 0.75rem;
		text-decoration: none;
	}
	.stats-link:hover {
		color: rgba(255, 255, 255, 0.75);
	}


	.archives {
		background: var(--color-navy);
		padding: 2rem 1.5rem 3rem;
	}
	.archives-details > summary {
		cursor: pointer;
		list-style: none;
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	.archives-details > summary::-webkit-details-marker {
		display: none;
	}
	.archives-details > summary::before {
		content: "▸";
		display: inline-block;
		margin-right: 0.6rem;
		transition: transform 0.15s ease;
	}
	.archives-details[open] > summary::before {
		transform: rotate(90deg);
	}
	.archives-grid {
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.25rem;
	}
	.card--archivee {
		background: var(--color-navy-deep);
	}
	@media (prefers-reduced-motion: reduce) {
		.archives-details > summary::before {
			transition: none;
		}
	}

	@media (max-width: 640px) {
		.archives-grid {
			grid-template-columns: 1fr;
		}
		.teams,
		.decouverte,
		.transversal {
			padding-left: 1rem;
			padding-right: 1rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.just-arrived {
			animation: arrived-pulse 1.4s ease;
		}
	}
	@keyframes arrived-pulse {
		0% {
			box-shadow: 0 0 0 3px var(--color-crimson);
		}
		100% {
			box-shadow: 0 0 0 3px transparent;
		}
	}
</style>
