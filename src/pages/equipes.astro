---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import ResultatsEquipe from "../components/resultats/ResultatsEquipe.astro";
import FicheEquipe from "../components/equipes/FicheEquipe.astro";
import Favicon from "../components/Favicon.astro";
import { withBase } from "../utils/links";
import { getCollection, type CollectionEntry } from "astro:content";
import { getAgendaTeams, getMatchesForEquipe } from "../lib/agenda";
import { saisonActuelle } from "../lib/saison";
import { trierEquipes } from "../lib/equipes";
import { getResultatsForEquipe, resultatsParSaison } from "../lib/resultats";
import { GROUPES, groupeEquipe, libelleCourtEquipe } from "../lib/ficheEquipe";
import { slugsAvecResultats } from "../lib/statistiques";

const allTeams = trierEquipes(await getCollection("equipes"));
const actives = allTeams.filter((t) => t.data.statut !== "archivee");
/** Équipes qui ont cessé de jouer (dissoutes, catégorie non reconduite...) :
 * plus affichées dans l'effectif, mais leurs résultats passés doivent rester
 * consultables -- voir GUIDE-EDITION.md, section "Changement de saison". */
const archivees = allTeams.filter((t) => t.data.statut === "archivee");

const agendaTeams = await getAgendaTeams();
/** Équipes ayant au moins un résultat importé (voir src/lib/statistiques.ts) :
 * seules celles-ci reçoivent les liens vers /statistiques et
 * /statistiques-carriere. Ces pages restent volontairement hors du menu de
 * navigation et non indexées : destinées aux joueurs, coachs et dirigeants,
 * pas mises en avant auprès du grand public. */
const slugsStats = await slugsAvecResultats();

const typeLabel: Record<string, string> = {
	decouverte: "Découverte",
	inclusion: "Inclusion",
};

/** Prochains matchs listés dans le détail d'une fiche (la suite est sur
 * /agenda?equipe=<slug>). */
const PROCHAINS_MATCHS = 6;
/** Derniers résultats de la saison en cours affichés à côté. */
const DERNIERS_RESULTATS = 3;

async function ficheProps(t: CollectionEntry<"equipes">) {
	const slug = t.data.slug;
	const calendriers = agendaTeams.filter((a) => a.equipeSlug === slug);
	const resultats = await getResultatsForEquipe(slug);
	return {
		equipe: t,
		calendriers,
		matchs: calendriers.length > 0 ? await getMatchesForEquipe(slug, PROCHAINS_MATCHS) : [],
		derniers: resultatsParSaison(resultats).saisonEnCours.slice(0, DERNIERS_RESULTATS),
		aDesResultats: resultats.length > 0,
		avecStats: slugsStats.has(slug),
		tag: typeLabel[t.data.type],
	};
}

/** Groupes non vides, dans l'ordre de GROUPES ; au sein d'un groupe, l'ordre
 * de trierEquipes() (du plus jeune au plus âgé). */
const groupes = (
	await Promise.all(
		GROUPES.map(async (g) => {
			const equipes = actives.filter((t) => groupeEquipe(t) === g.cle);
			return { ...g, equipes, fiches: await Promise.all(equipes.map(ficheProps)) };
		}),
	)
).filter((g) => g.equipes.length > 0);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Nos équipes — Handball Islois</title>
		<meta
			name="description"
			content="L'effectif complet du Handball Islois : jours, horaires, encadrants et tarifs, du baby hand aux seniors, ainsi que Handensemble et le créneau étirements/renforcement."
		/>
	</head>
	<body>
		<Header />
		<PageBanner
			title="Nos équipes"
			subtitle={`Du baby hand aux seniors, en passant par le handball adapté : l'effectif complet du HBI pour la saison ${saisonActuelle()}, entraînements au COSEC Émile Avy.`}
		/>

		<div class="equipes">
			{/* Barre "Aller à" : simples ancres, fonctionne sans JS. Collante sous le
			    header (lui-même collant) ; sur mobile, une seule ligne qui défile
			    horizontalement. */}
			<nav class="aller-a" aria-label="Aller à une équipe">
				<ul class="aller-a__groupes">
					{groupes.map((g) => (
						<li class="aller-a__groupe">
							{g.titreBarre && <span class="aller-a__titre">{g.titreBarre}</span>}
							<ul class="aller-a__liens">
								{g.equipes.map((t) => (
									<li>
										<a href={`#${t.data.slug}`} title={t.data.nom}>
											{libelleCourtEquipe(t)}
										</a>
									</li>
								))}
							</ul>
						</li>
					))}
				</ul>
			</nav>

			<div class="wrap">
				{groupes.map((g) => (
					<section class="groupe" id={`groupe-${g.cle}`} aria-labelledby={`titre-${g.cle}`}>
						<h2 id={`titre-${g.cle}`}>{g.titre}</h2>
						{g.cle === "decouverte" && (
							<p class="intro">Des créneaux ouverts à tous, pour découvrir le handball sans enjeu de compétition.</p>
						)}
						<div class="fiches">
							{g.fiches.map((f) => (
								<FicheEquipe {...f} />
							))}
						</div>
					</section>
				))}
			</div>
		</div>

		{
			archivees.length > 0 && (
				<section class="archives">
					<div class="wrap">
						<details class="archives-details">
							<summary>Équipes des saisons passées ({archivees.length})</summary>
							<div class="archives-grid">
								{archivees.map((t) => (
									<div class="card card--archivee" id={t.data.slug}>
										<h3>{t.data.nom}</h3>
										<ResultatsEquipe equipeSlug={t.data.slug} affichageStats={t.data.affichageStats} calendriers={t.data.calendriers} />
										{slugsStats.has(t.data.slug) && (
											<div class="stats-links">
												<a class="stats-link" href={withBase(`/statistiques#equipe-${t.data.slug}`)}>
													Statistiques de la saison →
												</a>
												<a class="stats-link" href={withBase(`/statistiques-carriere#equipe-${t.data.slug}`)}>
													Statistiques carrière →
												</a>
											</div>
										)}
									</div>
								))}
							</div>
						</details>
					</div>
				</section>
			)
		}

		<Footer />
	</body>
</html>

<script>
	// /equipes#<slug> : le navigateur fait défiler jusqu'à la fiche mais ne
	// l'ouvre pas (l'ancre vise le <details> lui-même). On l'ouvre -- ainsi que
	// le repli "Équipes des saisons passées" s'il la contient -- puis on
	// refait défiler, car l'ouverture (et la fermeture de la fiche
	// précédemment ouverte, voir name="equipe") décale la page. Sans JS :
	// défilement seul, fiche fermée, contenu accessible au clic.
	function ouvrirDepuisAncre() {
		const id = decodeURIComponent(window.location.hash.slice(1));
		const cible = id ? document.getElementById(id) : null;
		if (!cible) return;
		for (let el: HTMLElement | null = cible; el; el = el.parentElement) {
			if (el instanceof HTMLDetailsElement) el.open = true;
		}
		const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		cible.scrollIntoView({ block: "start", behavior: reduit ? "auto" : "smooth" });
		cible.classList.add("just-arrived");
		cible.addEventListener("animationend", () => cible.classList.remove("just-arrived"), { once: true });
	}
	ouvrirDepuisAncre();
	window.addEventListener("hashchange", ouvrirDepuisAncre);
</script>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>

<style>
	.equipes {
		/* Hauteur du header collant + de la barre "Aller à" : une fiche visée
		   par une ancre ne doit pas finir cachée dessous (voir
		   scroll-margin-top dans FicheEquipe). */
		--header-h: 64px;
		--barre-h: 6.5rem;
		--decalage-ancre: calc(var(--header-h) + var(--barre-h) + 0.75rem);
		background: var(--color-navy-deep);
		padding-bottom: 3.5rem;
	}

	.aller-a {
		position: sticky;
		top: var(--header-h);
		z-index: 40;
		background: var(--color-navy-deep);
		border-bottom: 1px solid color-mix(in srgb, var(--color-white) 18%, transparent);
		padding: 0.5rem 1.5rem;
	}
	.aller-a ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.aller-a__groupes {
		max-width: 1000px;
		margin: 0 auto !important;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.5rem;
	}
	/* Groupes séparés par un filet vertical, pour qu'ils se lisent comme des
	   groupes même sans titre. */
	.aller-a__groupe {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding-left: 0.5rem;
		border-left: 1px solid color-mix(in srgb, var(--color-white) 25%, transparent);
	}
	.aller-a__groupe:first-child {
		padding-left: 0;
		border-left: none;
	}
	.aller-a__titre {
		color: color-mix(in srgb, var(--color-white) 70%, transparent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.aller-a__liens {
		display: flex;
	}
	.aller-a a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 0.45rem;
		color: var(--color-white);
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
	}
	.aller-a a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.aller-a a:focus-visible {
		outline: 2px solid var(--color-white);
		outline-offset: -2px;
	}

	.wrap {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.groupe {
		padding-top: 2.5rem;
		scroll-margin-top: var(--decalage-ancre);
	}
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.4rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		margin: 0 0 0.9rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--color-white);
	}
	.intro {
		color: color-mix(in srgb, var(--color-white) 80%, transparent);
		margin: -0.3rem 0 1rem;
		line-height: 1.5;
	}
	.fiches {
		display: grid;
		gap: 0.6rem;
	}

	/* Cartes des équipes archivées (inchangées). */
	.card {
		padding: 1.25rem 1.4rem;
		scroll-margin-top: 5rem;
		border-radius: 4px;
	}
	.card h3 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0 0 0.75rem;
	}
	/* Volontairement discret (voir le commentaire sur slugsStats plus haut) :
	 * pas des boutons, deux simples lignes de texte en bas de carte. */
	.stats-links {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.75rem;
	}
	.stats-link {
		display: block;
		color: rgba(255, 255, 255, 0.45);
		font-size: 0.75rem;
		text-decoration: none;
	}
	.stats-link:hover {
		color: rgba(255, 255, 255, 0.75);
	}


	.archives {
		background: var(--color-navy);
		padding: 2rem 0 3rem;
	}
	.archives-details > summary {
		cursor: pointer;
		list-style: none;
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	.archives-details > summary::-webkit-details-marker {
		display: none;
	}
	.archives-details > summary::before {
		content: "▸";
		display: inline-block;
		margin-right: 0.6rem;
		transition: transform 0.15s ease;
	}
	.archives-details[open] > summary::before {
		transform: rotate(90deg);
	}
	.archives-grid {
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.25rem;
	}
	.card--archivee {
		background: var(--color-navy-deep);
	}
	@media (prefers-reduced-motion: reduce) {
		.archives-details > summary::before {
			transition: none;
		}
	}

	@media (max-width: 640px) {
		.archives-grid {
			grid-template-columns: 1fr;
		}
		.wrap {
			padding: 0 1rem;
		}
		.equipes {
			--barre-h: 3.25rem;
		}
		/* Une seule ligne qui défile horizontalement plutôt qu'une barre de
		   plusieurs lignes qui mangerait l'écran. */
		.aller-a {
			padding: 0.25rem 0;
		}
		.aller-a__groupes {
			flex-wrap: nowrap;
			overflow-x: auto;
			scrollbar-width: none;
			padding: 0 1rem !important;
			gap: 1rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(.just-arrived) {
			animation: arrived-pulse 1.4s ease;
		}
	}
	@keyframes arrived-pulse {
		0% {
			box-shadow: 0 0 0 3px var(--color-crimson);
		}
		100% {
			box-shadow: 0 0 0 3px transparent;
		}
	}
</style>
