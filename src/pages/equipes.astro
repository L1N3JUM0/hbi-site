---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import AjouterAgendaButton from "../components/AjouterAgendaButton.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import ResultatsEquipe from "../components/resultats/ResultatsEquipe.astro";
import Favicon from "../components/Favicon.astro";
import { withBase } from "../utils/links";
import { getCollection, type CollectionEntry } from "astro:content";
import { getAgendaTeams, getMatchesForEquipe, hasAgendaFeed, formatMatchDate, formatMatchTime } from "../lib/agenda";
import { saisonActuelle } from "../lib/saison";
import { trierEquipes } from "../lib/equipes";
import { slugsAvecStatistiques } from "../lib/statistiques";

const allTeams = trierEquipes(await getCollection("equipes"));
const actives = allTeams.filter((t) => t.data.statut !== "archivee");
const competition = actives.filter((t) => t.data.type === "competition");
const decouverte = actives.filter((t) => t.data.type === "decouverte" || t.data.type === "inclusion");
const transversal = actives.find((t) => t.data.type === "transversal");
/** Équipes qui ont cessé de jouer (dissoutes, catégorie non reconduite...) :
 * plus affichées dans l'effectif, mais leurs résultats passés doivent rester
 * consultables -- voir GUIDE-EDITION.md, section "Changement de saison". */
const archivees = allTeams.filter((t) => t.data.statut === "archivee");

const agendaTeams = await getAgendaTeams();
/** Équipes ayant des statistiques FFHandball publiées (voir
 * scripts/import-stats-ffhandball.mjs) : sert à n'afficher le lien discret
 * vers /statistiques que pour celles qui ont effectivement quelque chose à
 * montrer. Cette page reste volontairement hors du menu de navigation et
 * non indexée (voir src/pages/statistiques.astro) : destinée aux joueurs,
 * coachs et dirigeants, pas mise en avant auprès du grand public. */
const slugsStats = await slugsAvecStatistiques();

const typeLabel: Record<string, string> = {
	decouverte: "Découverte",
	inclusion: "Inclusion",
};

function agendaButtonsFor(slug: string) {
	return agendaTeams.filter((t) => t.equipeSlug === slug);
}

/** Prochains matchs à afficher sur la section de cette équipe (vide si pas
 * de flux configuré, ou pas de match à venir pour l'instant). */
async function nextMatchesFor(slug: string) {
	if (!(await hasAgendaFeed(slug))) return [];
	return getMatchesForEquipe(slug, 3);
}

/** Photos pour la carte équipe : `photoProfil` toujours en premier (c'est
 * elle, et elle seule, qui doit être visible sur la carte -- voir la
 * variante "card" de PhotoCarousel, qui n'affiche que la première photo),
 * suivie du reste de la galerie (sans dupliquer photoProfil si elle y
 * figure déjà) pour que la visionneuse plein écran, elle, montre bien la
 * galerie complète au clic. */
function photosFor(team: CollectionEntry<"equipes">) {
	const profil = { src: team.data.photoProfil, alt: `${team.data.nom} — photo de profil` };
	const reste = team.data.galerie
		.filter((src) => src.src !== team.data.photoProfil.src)
		.map((src, i) => ({ src, alt: `${team.data.nom} — photo ${i + 1}` }));
	return [profil, ...reste];
}
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Nos équipes — Handball Islois</title>
		<meta
			name="description"
			content="L'effectif complet du Handball Islois : jours, horaires, encadrants et tarifs, du baby hand aux seniors, ainsi que Handensemble et le créneau étirements/renforcement."
		/>
	</head>
	<body>
		<Header />
		<PageBanner
			title="Nos équipes"
			subtitle={`Du baby hand aux seniors, en passant par le handball adapté : l'effectif complet du HBI pour la saison ${saisonActuelle()}, entraînements au COSEC Émile Avy.`}
		/>

		<section class="teams">
			<div class="wrap">
				<h2>Équipes de compétition</h2>
				<div class="grid">
					{
						competition.map(async (t) => {
							const buttons = agendaButtonsFor(t.data.slug);
							const matches = await nextMatchesFor(t.data.slug);
							return (
								<div class="card" id={t.data.slug}>
									<h3>{t.data.nom}</h3>
									<PhotoCarousel photos={photosFor(t)} ariaLabel={`Photos de ${t.data.nom}`} lightbox variant="card" />
									<p class="description">{t.data.description}</p>
									<dl>
										<div class="row">
											<dt>Jours &amp; horaires</dt>
											<dd>{t.data.horaires}</dd>
										</div>
										<div class="row">
											<dt>Encadrant(s)</dt>
											<dd>{t.data.encadrants}</dd>
										</div>
										<div class="row">
											<dt>Tarif licence</dt>
											<dd>{t.data.tarif}</dd>
										</div>
									</dl>
									{matches.length > 0 && (
										<div class="next-matches">
											<p class="next-matches__title">Prochains matchs</p>
											<ul>
												{matches.map((m) => (
													<li>
														<span class={`badge ${m.isHome ? "badge--home" : "badge--away"}`}>
															{m.isHome ? "D" : "E"}
														</span>
														<span class="next-matches__text">
															{m.isDerby ? m.teamLabel : `vs ${m.opponent}`} — {formatMatchDate(m.start)} à {formatMatchTime(m.start)}
														</span>
													</li>
												))}
											</ul>
										</div>
									)}
									{buttons.length > 0 && (
										<div class="card-agenda">
											{buttons.map((at) => (
												<AjouterAgendaButton
													href={at.urlIcs}
													label={buttons.length > 1 ? `Agenda ${at.nomAffiche.replace(t.data.nom, "").trim()}` : "Ajouter à mon agenda"}
												/>
											))}
											<a class="agenda-link" href={withBase("/agenda")}>
												Voir l&rsquo;agenda →
											</a>
										</div>
									)}
									<ResultatsEquipe equipeSlug={t.data.slug} affichageStats={t.data.affichageStats} calendriers={t.data.calendriers} />
									{slugsStats.has(t.data.slug) && (
										<a class="stats-link" href={withBase(`/statistiques#equipe-${t.data.slug}`)}>
											Statistiques FFHandball →
										</a>
									)}
								</div>
							);
						})
					}
				</div>
			</div>
		</section>

		<section class="decouverte">
			<div class="wrap">
				<h2>Découverte &amp; inclusion</h2>
				<p class="intro">
					Deux créneaux ouverts à tous, pensés pour découvrir le handball sans
					enjeu de compétition.
				</p>
				<div class="grid grid--decouverte">
					{
						decouverte.map((t) => (
							<div class="card card--decouverte" id={t.data.slug}>
								<span class="tag">{typeLabel[t.data.type]}</span>
								<h3>{t.data.nom}</h3>
								<PhotoCarousel photos={photosFor(t)} ariaLabel={`Photos de ${t.data.nom}`} lightbox variant="card" />
								<p class="description">{t.data.description}</p>
								<dl>
									<div class="row">
										<dt>Jours &amp; horaires</dt>
										<dd>{t.data.horaires}</dd>
									</div>
									<div class="row">
										<dt>Encadrant(s)</dt>
										<dd>{t.data.encadrants}</dd>
									</div>
									<div class="row">
										<dt>Tarif licence</dt>
										<dd>{t.data.tarif}</dd>
									</div>
								</dl>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{
			transversal && (
				<section class="transversal">
					<div class="wrap">
						<h2>Créneau transversal</h2>
						<div class="card card--transversal" id={transversal.data.slug}>
							<h3>{transversal.data.nom}</h3>
							<PhotoCarousel
								photos={photosFor(transversal)}
								ariaLabel={`Photos de ${transversal.data.nom}`}
								lightbox
								variant="card"
							/>
							<p class="description">{transversal.data.description}</p>
							<dl>
								<div class="row">
									<dt>Jours &amp; horaires</dt>
									<dd>{transversal.data.horaires}</dd>
								</div>
								<div class="row">
									<dt>Encadrant(s)</dt>
									<dd>{transversal.data.encadrants}</dd>
								</div>
								<div class="row">
									<dt>Tarif</dt>
									<dd>{transversal.data.tarif}</dd>
								</div>
							</dl>
						</div>
					</div>
				</section>
			)
		}

		{
			archivees.length > 0 && (
				<section class="archives">
					<div class="wrap">
						<details class="archives-details">
							<summary>Équipes des saisons passées ({archivees.length})</summary>
							<div class="archives-grid">
								{archivees.map((t) => (
									<div class="card card--archivee" id={t.data.slug}>
										<h3>{t.data.nom}</h3>
										<ResultatsEquipe equipeSlug={t.data.slug} affichageStats={t.data.affichageStats} calendriers={t.data.calendriers} />
									</div>
								))}
							</div>
						</details>
					</div>
				</section>
			)
		}

		<Footer />
	</body>
</html>

<script>
	// Léger défilement/mise en évidence quand on arrive via une ancre
	// (#slug) depuis la homepage.
	const id = window.location.hash.replace("#", "");
	if (id) {
		const target = document.getElementById(id);
		if (target) {
			target.classList.add("just-arrived");
			target.addEventListener("animationend", () => target.classList.remove("just-arrived"), { once: true });
		}
	}
</script>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>

<style>
	h2 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		text-align: center;
		margin: 0 0 0.75rem;
	}
	.intro {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
		max-width: 560px;
		margin: 0 auto 2rem;
		line-height: 1.6;
	}

	.teams {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem;
	}
	.decouverte {
		background: var(--color-navy);
		padding: 3.5rem 1.5rem;
	}
	.transversal {
		background: var(--color-navy-deep);
		padding: 3.5rem 1.5rem 4rem;
	}

	.wrap {
		max-width: 1000px;
		margin: 0 auto;
	}

	.teams h2 {
		margin-bottom: 2rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.25rem;
	}

	.card {
		background: var(--color-blue);
		padding: 1.25rem 1.4rem;
		scroll-margin-top: 5rem;
		border-radius: 4px;
	}
	.card h3 {
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		margin: 0 0 0.75rem;
	}
	.card :global(.photo-carousel) {
		margin: 0 0 0.9rem;
	}
	.card .description {
		color: rgba(255, 255, 255, 0.9);
		font-size: 0.92rem;
		line-height: 1.5;
		margin: 0 0 0.9rem;
	}
	.card dl {
		margin: 0;
	}
	.card .row {
		padding: 0.5rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}
	.card .row:first-child {
		border-top: none;
	}
	.card dt {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
		margin: 0 0 0.15rem;
	}
	.card dd {
		color: var(--color-white);
		font-size: 0.95rem;
		line-height: 1.4;
		margin: 0;
	}

	.next-matches {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}
	.next-matches__title {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}
	.next-matches ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}
	.next-matches li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.3rem;
		height: 1.3rem;
		border-radius: 999px;
		font-weight: 800;
		font-size: 0.7rem;
		flex-shrink: 0;
	}
	.badge--home {
		background: var(--color-crimson);
		color: var(--color-white);
	}
	.badge--away {
		background: rgba(255, 255, 255, 0.2);
		color: var(--color-white);
	}
	.next-matches__text {
		color: var(--color-white);
		font-size: 0.85rem;
	}

	.card-agenda {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}
	.agenda-link {
		color: rgba(255, 255, 255, 0.85);
		font-weight: 700;
		font-size: 0.85rem;
		text-decoration: none;
		border-bottom: 2px solid var(--color-crimson);
		padding-bottom: 0.1rem;
	}
	.agenda-link:hover {
		color: var(--color-crimson);
	}
	/* Volontairement discret (voir le commentaire sur slugsStats plus haut) :
	 * pas un bouton, une simple ligne de texte en bas de carte. */
	.stats-link {
		display: block;
		margin-top: 0.75rem;
		color: rgba(255, 255, 255, 0.45);
		font-size: 0.75rem;
		text-decoration: none;
	}
	.stats-link:hover {
		color: rgba(255, 255, 255, 0.75);
	}

	.card--decouverte {
		background: var(--color-navy-deep);
		border-left: 3px solid var(--color-crimson);
	}
	.tag {
		display: inline-block;
		background: var(--color-crimson);
		color: var(--color-white);
		font-weight: 800;
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.2rem 0.55rem;
		margin-bottom: 0.6rem;
	}

	.transversal h2 {
		margin-bottom: 2rem;
	}
	.card--transversal {
		background: var(--color-navy);
		border-left: 3px solid var(--color-crimson);
		max-width: 480px;
		margin: 0 auto;
	}

	.archives {
		background: var(--color-navy);
		padding: 2rem 1.5rem 3rem;
	}
	.archives-details > summary {
		cursor: pointer;
		list-style: none;
		color: var(--color-white);
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		font-weight: 800;
		font-size: 1.1rem;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	.archives-details > summary::-webkit-details-marker {
		display: none;
	}
	.archives-details > summary::before {
		content: "▸";
		display: inline-block;
		margin-right: 0.6rem;
		transition: transform 0.15s ease;
	}
	.archives-details[open] > summary::before {
		transform: rotate(90deg);
	}
	.archives-grid {
		margin-top: 1.5rem;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.25rem;
	}
	.card--archivee {
		background: var(--color-navy-deep);
	}
	@media (prefers-reduced-motion: reduce) {
		.archives-details > summary::before {
			transition: none;
		}
	}

	@media (max-width: 640px) {
		.grid,
		.archives-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.just-arrived {
			animation: arrived-pulse 1.4s ease;
		}
	}
	@keyframes arrived-pulse {
		0% {
			box-shadow: 0 0 0 3px var(--color-crimson);
		}
		100% {
			box-shadow: 0 0 0 3px transparent;
		}
	}
</style>
