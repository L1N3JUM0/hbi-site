---
import "../styles/tokens.css";
import "../styles/graphe.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import Favicon from "../components/Favicon.astro";
import { getCollection } from "astro:content";
import { trierEquipes } from "../lib/equipes";
import { slugsAvecResultats, getStatistiquesParSaison, type MatchJoueur } from "../lib/statistiques";
import { withBase } from "../utils/links";
import CelluleEfficacite from "../components/CelluleEfficacite.astro";
import CellulePart from "../components/CellulePart.astro";
import { partButs, SEUIL_PART_FORTE } from "../lib/partButs.mjs";
import { efficaciteTri, estGardien, SEUIL_TIRS_SAISON } from "../lib/efficacite";
import { categorieActuelleParHash } from "../lib/carriereJoueur";

const slugsDisponibles = await slugsAvecResultats();
const equipes = trierEquipes(await getCollection("equipes")).filter((e) => slugsDisponibles.has(e.data.slug));

// Détail match par match : réservé aux personnes dont la catégorie ACTUELLE
// est affichée en nom complet (U17 et plus), comme la fiche détaillée de
// /statistiques-carriere (même calcul, categorieActuelleParHash). Pour qui
// n'est plus dans aucun effectif récent (a quitté le club), l'équipe de son
// dernier match en tient lieu : un·e ancien·ne senior garde son détail, un
// enfant parti en U13 reste sans détail. Sans aucune équipe connue, rien.
const categorieActuelle = await categorieActuelleParHash(equipes.map((e) => e.data.slug));
const dernierMatch = new Map<string, { date: Date; slug: string }>();
for (const r of await getCollection("resultats")) {
	for (const j of r.data.statsJoueurs ?? []) {
		const actuel = j.licenceHash ? dernierMatch.get(j.licenceHash) : undefined;
		if (j.licenceHash && (!actuel || r.data.date > actuel.date)) dernierMatch.set(j.licenceHash, { date: r.data.date, slug: r.data.equipeSlug });
	}
}
const affichageParSlug = new Map(equipes.map((e) => [e.data.slug, e.data.affichageStats]));
const detailAutorise = (hashes: string[]) =>
	hashes.length > 0 &&
	hashes.every((h) => affichageParSlug.get(categorieActuelle.get(h) ?? dernierMatch.get(h)?.slug ?? "") === "nominatif");

const blocs = await Promise.all(
	equipes.map(async (e) => ({
		equipe: e,
		saisons: await getStatistiquesParSaison(e.data.slug, e.data.calendriers, e.data.affichageStats, detailAutorise),
	})),
);

// Données du détail, compactes et en un seul bloc JSON pour toute la page
// (un panneau complet rendu pour chaque joueur·se de chaque saison doublait
// son poids) : par identifiant de panneau, [date, adversaire, buts, 7m,
// tirs, arrêts, avert., excl., buts de l'équipe] par match. Rempli pendant
// le rendu du tableau, sérialisé en bas de page.
const donneesMatchs: Record<string, (string | number)[][]> = {};
// Jour du match à Paris (AAAA-MM-JJ), pas le jour UTC.
const jourParis = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Paris" });
const enregistrer = (id: string, matchs: MatchJoueur[]) => {
	donneesMatchs[id] = matchs.map((m) => [jourParis.format(new Date(m.date)), m.adversaire, m.buts, m.sept_m, m.tirs, m.arrets, m.avertissements, m.exclusions, m.butsEquipe]);
	return id;
};
const COLONNES_TABLEAU = 11;

// Tri par colonne (même fonctionnement que /statistiques-carriere) : chaque
// ligne porte ses valeurs de tri en data-value-*. Efficacité absente ou sous
// le seuil de tirs : attribut omis, rangée en fin de tri dans les deux sens.
type Joueur = Awaited<ReturnType<typeof getStatistiquesParSaison>>[number]["joueurs"][number];
const COLONNES_TRI: { key: string; titre: string; abbr?: string; valeur: (j: Joueur) => number | null }[] = [
	{ key: "matchs", titre: "Matchs", valeur: (j) => j.matchsJoues },
	{ key: "buts", titre: "Buts", valeur: (j) => j.buts },
	{ key: "part", titre: "Part", abbr: "Part des buts de l'équipe sur les matchs joués", valeur: (j) => partButs(j.buts, j.butsEquipe) },
	{ key: "sept_m", titre: "7m", valeur: (j) => j.sept_m },
	{ key: "tirs", titre: "Tirs", valeur: (j) => j.tirs },
	{ key: "efficacite", titre: "Effic.", abbr: "Efficacité : buts ÷ tirs", valeur: (j) => efficaciteTri(j, SEUIL_TIRS_SAISON) },
	{ key: "arrets", titre: "Arrêts", valeur: (j) => j.arrets },
	{ key: "avertissements", titre: "Avert.", valeur: (j) => j.avertissements },
	{ key: "exclusions", titre: "Excl.", valeur: (j) => j.exclusions },
	{ key: "disqualifications", titre: "Disq.", valeur: (j) => j.disqualifications },
];
const attributsTri = (j: Joueur) => ({
	"data-value-joueur": (j.label ?? "").toLowerCase(),
	...Object.fromEntries(COLONNES_TRI.map((c) => [`data-value-${c.key}`, c.valeur(j)])),
});
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Statistiques — Handball Islois</title>
		<meta
			name="description"
			content="Bilan et statistiques joueurs de chaque équipe du Handball Islois, saison par saison, à partir des feuilles de match officielles."
		/>
		{
			/* Page destinée aux joueurs/coachs/dirigeants, accessible uniquement
			via un lien discret depuis /equipes -- volontairement absente du menu
			de navigation ET non indexée : publique (n'importe qui avec le lien y
			accède), mais pas mise en avant auprès du grand public. */
		}
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<Header />
		<PageBanner title="Statistiques" subtitle="Bilan et statistiques joueurs, saison par saison, à partir des feuilles de match officielles." />

		{
			blocs.length === 0 ? (
				<section class="stats-content">
					<div class="wrap empty">
						<p>Aucune statistique disponible pour le moment.</p>
					</div>
				</section>
			) : (
				<section class="stats-content">
					<div class="wrap">
						<div class="filtres">
							<div>
								<label class="filtre-label" for="filtre-equipe">
									Équipe
								</label>
								<select id="filtre-equipe">
									{blocs
										.filter(({ saisons }) => saisons.length > 0)
										.map(({ equipe }) => (
											<option value={equipe.data.slug}>{equipe.data.nom}</option>
										))}
								</select>
							</div>
							<div>
								<label class="filtre-label" for="filtre-saison">
									Saison
								</label>
								<select id="filtre-saison" />
							</div>
						</div>

						<p class="legende">
							Cliquer sur un en-tête pour trier. Effic. : buts ÷ tirs. Sous {SEUIL_TIRS_SAISON} tirs, atténuée et rangée en fin de tri ;
							« – » pour un·e gardien·ne, aucun tir, ou plus de buts que de tirs sur les feuilles. Part : buts du joueur ÷ buts de son
							équipe sur les matchs qu'il a joués ; en fuchsia à partir de {SEUIL_PART_FORTE} %.
						</p>

						{blocs.map(({ equipe, saisons }) =>
							saisons.map((s) => (
								<section
									class="saison-bloc"
									id={`equipe-${equipe.data.slug}-${s.saison}`}
									data-equipe-slug={equipe.data.slug}
									data-saison={s.saison}
								>
									<h2>
										{equipe.data.nom} <span class="saison-label">— {s.saison}</span>
									</h2>
									{s.groupes.map((groupe) => (
										<div class="groupe">
											{s.plusieursEquipes && <h3>{groupe.libelle}</h3>}

											<dl class="bilan">
												<div>
													<dt>J / G / N / P</dt>
													<dd>
														{groupe.bilan.matchsJoues} / {groupe.bilan.victoires} / {groupe.bilan.nuls} /{" "}
														{groupe.bilan.defaites}
													</dd>
												</div>
												<div>
													<dt>Buts pour / contre</dt>
													<dd>
														{groupe.bilan.butsPour} / {groupe.bilan.butsContre}
													</dd>
												</div>
												<div>
													<dt>Différence</dt>
													<dd>
														{groupe.bilan.diff > 0 ? "+" : ""}
														{groupe.bilan.diff}
													</dd>
												</div>
											</dl>
										</div>
									))}

									{s.joueurs.length > 0 && s.plusieursEquipes && <h3 class="titre-joueurs">Joueur·se·s — toutes équipes confondues</h3>}
									{s.joueurs.length > 0 && (
										<div class="table-scroll">
											<table class="joueurs">
												<thead>
													<tr>
														<th scope="col" aria-sort="none">
															<button type="button" class="sort-btn" data-key="joueur" data-type="text">
																Joueur·se
																<span class="sort-indicator" aria-hidden="true" />
															</button>
														</th>
														{COLONNES_TRI.map((c) => (
															<th scope="col" aria-sort={c.key === "buts" ? "descending" : "none"}>
																<button type="button" class="sort-btn" data-key={c.key} data-type="num">
																	{c.abbr ? <abbr title={c.abbr}>{c.titre}</abbr> : c.titre}
																	<span class="sort-indicator" aria-hidden="true" />
																</button>
															</th>
														))}
													</tr>
												</thead>
												<tbody>
													{s.joueurs.map((j, i) => {
														const detailId = `matchs-${equipe.data.slug}-${s.saison}-${i}`;
														return (
															<>
																<tr class="joueur-row" {...attributsTri(j)}>
																	<td>
																		{j.matchs ? (
																			<button type="button" class="nom-btn" aria-expanded="false" aria-controls={detailId}>
																				<span class="nom">{j.label}</span>
																			</button>
																		) : (
																			<span class="nom">{j.label}</span>
																		)}
																	</td>
																	<td>{j.matchsJoues}</td>
																	<td>{j.buts}</td>
																	<td>
																		<CellulePart buts={j.buts} butsEquipe={j.butsEquipe} />
																	</td>
																	<td>{j.sept_m}</td>
																	<td>{j.tirs}</td>
																	<td>
																		<CelluleEfficacite buts={j.buts} tirs={j.tirs} arrets={j.arrets} seuil={SEUIL_TIRS_SAISON} />
																	</td>
																	<td>{j.arrets}</td>
																	<td>{j.avertissements}</td>
																	<td>{j.exclusions}</td>
																	<td>{j.disqualifications}</td>
																</tr>
																{j.matchs && (
																	<tr class="detail-row" id={detailId} hidden>
																		<td colspan={COLONNES_TABLEAU}>
																			<div
																				class="match-panel"
																				data-id={enregistrer(detailId, j.matchs)}
																				data-nom={j.label}
																				data-saison={s.saison}
																				data-gardien={String(estGardien(j))}
																			/>
																		</td>
																	</tr>
																)}
															</>
														);
													})}
												</tbody>
											</table>
										</div>
									)}
								</section>
							)),
						)}
						{/* Simple lien texte en bas de page, seul accès à /records (hors
						menu et accueil, non indexée -- décision du 30/09/2026). */}
						<p class="lien-records"><a href={withBase("/records")}>Records et meilleures performances</a></p>
						
						{/* Gabarit du panneau match par match, cloné à l'ouverture (voir le
						script plus bas) ; les identifiants y sont complétés à chaque copie. */}
						<template id="gabarit-matchs">
							<label class="filtre-label">
								Paramètre affiché
							</label>
							<select class="match-param">
								<option value="buts">Buts</option>
								<option value="part">Part des buts</option>
								<option value="tirs">Tirs</option>
								<option value="efficacite">Efficacité</option>
								<option value="arrets">Arrêts</option>
								<option value="avertissements">Avertissements</option>
								<option value="exclusions">Exclusions</option>
								<option value="sept_m">7m</option>
							</select>
							<figure class="graphe">
								<figcaption />
								<div class="graphe-svg" />
							</figure>
							<div class="match-scroll">
								<table class="match-table">
									<caption />
									<thead>
										<tr>
											<th scope="col">Date</th>
											<th scope="col">Adversaire</th>
											<th scope="col">Buts</th>
											<th scope="col"><abbr title="Part des buts de l'équipe sur ce match">Part</abbr></th>
											<th scope="col">7m</th>
											<th scope="col">Tirs</th>
											<th scope="col">Effic.</th>
											<th scope="col">Arrêts</th>
											<th scope="col">Avert.</th>
											<th scope="col">Excl.</th>
										</tr>
									</thead>
									<tbody />
									<tfoot />
								</table>
							</div>
							<p class="match-note">Les matchs dont la feuille n'a pas été importée n'apparaissent pas.</p>
						</template>
						<script type="application/json" id="donnees-matchs" set:html={JSON.stringify(donneesMatchs).replace(/</g, "\\u003c")} />
					</div>
				</section>
			)
		}

		<Footer />

		<script>
			const selectEquipe = document.querySelector<HTMLSelectElement>("#filtre-equipe");
			const selectSaison = document.querySelector<HTMLSelectElement>("#filtre-saison");
			const blocs = document.querySelectorAll<HTMLElement>(".saison-bloc");

			function saisonsDe(slug: string): string[] {
				const vues = new Set<string>();
				const saisons: string[] = [];
				for (const bloc of blocs) {
					if (bloc.dataset.equipeSlug !== slug) continue;
					const saison = bloc.dataset.saison!;
					if (!vues.has(saison)) {
						vues.add(saison);
						saisons.push(saison);
					}
				}
				return saisons;
			}

			function afficher(slug: string, saison: string) {
				for (const bloc of blocs) {
					bloc.hidden = bloc.dataset.equipeSlug !== slug || bloc.dataset.saison !== saison;
				}
			}

			function peuplerSaisons(slug: string, saisonPreferee?: string) {
				if (!selectSaison) return;
				const saisons = saisonsDe(slug);
				selectSaison.innerHTML = saisons.map((s) => `<option value="${s}">${s}</option>`).join("");
				selectSaison.value = saisonPreferee && saisons.includes(saisonPreferee) ? saisonPreferee : (saisons[0] ?? "");
			}

			if (selectEquipe && selectSaison && blocs.length > 0) {
				// Lien discret depuis la fiche équipe (ex. #equipe-seniors-masculins,
				// sans saison précisée -> saison en cours) : présélectionne cette
				// équipe (et, si présente, la saison) dans les filtres, en plus du
				// saut d'ancre natif du navigateur (qui fonctionne même sans JS).
				const cible = location.hash.replace(/^#equipe-/, "");
				const [slugDepuisAncre, saisonDepuisAncre] = cible.includes("-20") ? [cible.replace(/-\d{4}-\d{4}$/, ""), cible.match(/(\d{4}-\d{4})$/)?.[1]] : [cible, undefined];
				const optionCorrespondante = slugDepuisAncre && selectEquipe.querySelector(`option[value="${slugDepuisAncre}"]`);
				if (optionCorrespondante) selectEquipe.value = slugDepuisAncre;

				peuplerSaisons(selectEquipe.value, saisonDepuisAncre);
				afficher(selectEquipe.value, selectSaison.value);

				selectEquipe.addEventListener("change", () => {
					peuplerSaisons(selectEquipe.value);
					afficher(selectEquipe.value, selectSaison.value);
				});
				selectSaison.addEventListener("change", () => afficher(selectEquipe.value, selectSaison.value));
	}

	// --- Tri par colonne -------------------------------------------------
	// Chaque tableau se trie seul. Une ligne joueur et son panneau match par
	// match éventuel se déplacent ensemble, le panneau restant sous son nom.
	for (const table of document.querySelectorAll<HTMLTableElement>("table.joueurs")) {
				const tbody = table.tBodies[0];
				if (!tbody) continue;
				const boutons = [...table.querySelectorAll<HTMLButtonElement>(":scope > thead .sort-btn")];
				// Ordre initial du build : buts décroissants.
				let triActuel: { key: string; sens: 1 | -1 } = { key: "buts", sens: -1 };

				/** `null` : hors classement (efficacité absente ou sous le seuil de
				 * tirs, attribut omis au build), toujours en fin de tri. */
				const valeur = (row: HTMLTableRowElement, key: string, type: string): string | number | null => {
					const brut = row.getAttribute(`data-value-${key}`);
					if (type === "num") return brut === null ? null : Number(brut);
					return brut ?? "";
				};

				for (const bouton of boutons) {
					bouton.addEventListener("click", () => {
						const key = bouton.dataset.key!;
						const type = bouton.dataset.type ?? "text";
						// Nouveau tri : décroissant pour un chiffre (le meilleur en tête),
						// alphabétique pour le nom ; second clic : sens inversé.
						const sens: 1 | -1 = triActuel.key === key ? (triActuel.sens === 1 ? -1 : 1) : type === "num" ? -1 : 1;
						triActuel = { key, sens };

						const paires = [...tbody.querySelectorAll<HTMLTableRowElement>(":scope > tr.joueur-row")].map((main) => {
							const suivante = main.nextElementSibling;
							return { main, detail: suivante?.classList.contains("detail-row") ? suivante : null };
						});
						paires.sort((a, b) => {
							const va = valeur(a.main, key, type);
							const vb = valeur(b.main, key, type);
							if (va === null || vb === null) return va === vb ? 0 : va === null ? 1 : -1;
							if (typeof va === "number" && typeof vb === "number") return (va - vb) * sens;
							return String(va).localeCompare(String(vb), "fr") * sens;
						});
						for (const { main, detail } of paires) {
							tbody.append(main);
							if (detail) tbody.append(detail);
						}
						table.closest<HTMLElement>(".table-scroll")?.scrollTo({ top: 0 });

						for (const autre of boutons) autre.closest("th")?.setAttribute("aria-sort", "none");
						bouton.closest("th")?.setAttribute("aria-sort", sens === 1 ? "ascending" : "descending");
					});
				}
	}
</script>

	<script>
		// --- Détail match par match (clic sur un nom affiché en nom complet) ---
		// Tableau et graphique construits à la première ouverture, depuis les
		// données compactes du panneau : les rendre au build pour chaque
		// joueur·se de chaque saison alourdirait la page d'environ 1 Mo.
		import { svgBarres } from "../lib/grapheBarres";
		import { efficacite } from "../lib/efficacite";
		import { partButs, SEUIL_PART_FORTE } from "../lib/partButs.mjs";

		type Match = { date: Date; adversaire: string; buts: number; butsEquipe: number; sept_m: number; tirs: number; arrets: number; avertissements: number; exclusions: number };
		type Parametre = "buts" | "part" | "tirs" | "efficacite" | "arrets" | "avertissements" | "exclusions" | "sept_m";

		const TITRES: Record<Parametre, string> = {
				buts: "Buts",
				part: "Part des buts (%)",
				tirs: "Tirs",
				efficacite: "Efficacité (%)",
				arrets: "Arrêts",
				avertissements: "Avertissements",
				exclusions: "Exclusions",
				sept_m: "Buts à 7m",
		};
		const dateLongue = new Intl.DateTimeFormat("fr-FR", { day: "2-digit", month: "2-digit", year: "2-digit", timeZone: "Europe/Paris" });
		const dateCourte = new Intl.DateTimeFormat("fr-FR", { day: "2-digit", month: "2-digit", timeZone: "Europe/Paris" });

		/** Efficacité d'un match : `null` sans tir (une absence de valeur,
		 * jamais un 0 %), pour un·e gardien·ne ou une feuille incohérente. */
		const efficaciteMatch = (m: Match, gardien: boolean) => (gardien ? null : efficacite(m, 1).pct);

		const valeur = (m: Match, p: Parametre, gardien: boolean): number | null =>
				p === "efficacite" ? efficaciteMatch(m, gardien) : p === "part" ? partButs(m.buts, m.butsEquipe) : m[p];

		/** Cellule « Part » : marquée `forte` à partir de la moitié des buts
		 * de l'équipe, comme dans le tableau de saison. */
		function cellulePart(buts: number, butsEquipe: number) {
				const pct = partButs(buts, butsEquipe);
				const td = cellule(pct === null ? "–" : `${pct} %`, pct === null ? "Part non calculable" : `${buts} buts sur ${butsEquipe} marqués par l'équipe`);
				if (pct !== null && pct >= SEUIL_PART_FORTE) td.classList.add("forte");
				return td;
		}

		function cellule(texte: string | number, titre?: string) {
				const td = document.createElement("td");
				td.textContent = String(texte);
				if (titre) td.title = titre;
				return td;
		}

		let donnees: Record<string, [string, string, number, number, number, number, number, number, number][]> | null = null;
		
		function construire(panneau: HTMLElement) {
			donnees ??= JSON.parse(document.getElementById("donnees-matchs")?.textContent ?? "{}");
			const id = panneau.dataset.id!;
			const lignes = donnees![id] ?? [];
			const gabarit = document.querySelector<HTMLTemplateElement>("#gabarit-matchs")!.content.cloneNode(true) as DocumentFragment;
			const champ = gabarit.querySelector<HTMLSelectElement>(".match-param")!;
			champ.id = `${id}-param`;
			gabarit.querySelector("label")!.htmlFor = champ.id;
			panneau.append(gabarit);
				const matchs: Match[] = lignes.map(([date, adversaire, buts, sept_m, tirs, arrets, avertissements, exclusions, butsEquipe]) => ({
					date: new Date(date),
					adversaire,
					buts,
					butsEquipe,
					sept_m,
					tirs,
					arrets,
					avertissements,
					exclusions,
				}));
				const gardien = panneau.dataset.gardien === "true";
				const nom = panneau.dataset.nom ?? "";
				panneau.querySelector("caption")!.textContent = `Matchs de ${nom}, saison ${panneau.dataset.saison}`;

				// Tableau : l'équivalent texte du graphique, total en pied.
				const tbody = panneau.querySelector("tbody")!;
				for (const m of matchs) {
					const tr = document.createElement("tr");
					const eff = efficaciteMatch(m, gardien);
					tr.append(
						cellule(dateLongue.format(m.date)),
						cellule(m.adversaire, m.adversaire),
						cellule(m.buts),
						cellulePart(m.buts, m.butsEquipe),
						cellule(m.sept_m),
						cellule(m.tirs),
						cellule(eff === null ? "–" : `${eff} %`, eff === null ? (gardien ? "Gardien·ne" : m.tirs === 0 ? "Aucun tir" : "Donnée incohérente") : `${m.buts} buts sur ${m.tirs} tirs`),
						cellule(m.arrets),
						cellule(m.avertissements),
						cellule(m.exclusions),
					);
					tbody.append(tr);
				}
				const somme = (cle: keyof Omit<Match, "date" | "adversaire">) => matchs.reduce((t, m) => t + m[cle], 0);
				const total = { buts: somme("buts"), tirs: somme("tirs"), arrets: somme("arrets") };
				const effTotale = gardien ? null : efficacite(total, 1).pct;
				const pied = document.createElement("tr");
				const libelle = document.createElement("th");
				libelle.scope = "row";
				libelle.colSpan = 2;
				libelle.textContent = `Total (${matchs.length} match${matchs.length > 1 ? "s" : ""})`;
				pied.append(
					libelle,
					cellule(total.buts),
					cellulePart(total.buts, somme("butsEquipe")),
					cellule(somme("sept_m")),
					cellule(total.tirs),
					cellule(effTotale === null ? "–" : `${effTotale} %`),
					cellule(total.arrets),
					cellule(somme("avertissements")),
					cellule(somme("exclusions")),
				);
				panneau.querySelector("tfoot")!.append(pied);

				// Graphique : le paramètre choisi dans le menu.
				const select = panneau.querySelector<HTMLSelectElement>(".match-param")!;
				const legende = panneau.querySelector("figcaption")!;
				const zone = panneau.querySelector<HTMLElement>(".graphe-svg")!;
				function dessiner() {
					const p = select.value as Parametre;
					legende.textContent = `${TITRES[p]} par match`;
					zone.innerHTML = svgBarres(
						matchs.map((m) => ({ libelle: dateCourte.format(m.date), valeur: valeur(m, p, gardien) })),
						`${TITRES[p]} par match de ${nom}, saison ${panneau.dataset.saison} : valeurs détaillées dans le tableau ci-dessous.`,
					);
				}
				// Gardien·ne : les arrêts d'abord, les buts n'en disent rien.
				if (gardien) select.value = "arrets";
				select.addEventListener("change", dessiner);
				dessiner();
		}

		for (const bouton of document.querySelectorAll<HTMLButtonElement>(".nom-btn")) {
				bouton.addEventListener("click", () => {
					const ligne = document.getElementById(bouton.getAttribute("aria-controls")!);
					if (!ligne) return;
					const ouvrir = bouton.getAttribute("aria-expanded") !== "true";
					const panneau = ligne.querySelector<HTMLElement>(".match-panel")!;
					if (ouvrir && !panneau.dataset.construit) {
						construire(panneau);
						panneau.dataset.construit = "true";
					}
					bouton.setAttribute("aria-expanded", String(ouvrir));
					ligne.hidden = !ouvrir;
				});
		}
	</script>
	</body>
</html>

