---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PhotoBand from "../components/PhotoBand.astro";
import ProchainMatchDomicile from "../components/ProchainMatchDomicile.astro";
import Histoire from "../components/Histoire.astro";
import Equipes from "../components/Equipes.astro";
import Parrain from "../components/Parrain.astro";
import Partenaires from "../components/Partenaires.astro";
import Recrutement from "../components/Recrutement.astro";
import Footer from "../components/Footer.astro";
import Favicon from "../components/Favicon.astro";
import { withBase } from "../utils/links";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Handball Islois — L&rsquo;Isle-sur-la-Sorgue</title>
		<meta
			name="description"
			content="Le Handball Islois : club de handball familial à L'Isle-sur-la-Sorgue, du baby hand aux seniors, handball adapté inclus."
		/>
	</head>
	<body>
		<Header />
		<Hero />
		<PhotoBand />
		<ProchainMatchDomicile />
		<Equipes />
		<Histoire />
		<Parrain />
		<Partenaires />
		<Recrutement />
		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		padding: 0;
	}
	body {
		font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
		background: var(--color-navy-deep);
	}
</style>

