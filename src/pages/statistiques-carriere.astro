---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import PageBanner from "../components/PageBanner.astro";
import Footer from "../components/Footer.astro";
import Favicon from "../components/Favicon.astro";
import { getCollection } from "astro:content";
import { trierEquipes } from "../lib/equipes";
import { slugsAvecResultats } from "../lib/statistiques";
import { categorieActuelleParHash, getCarriereParEquipe, type JoueurCarriere } from "../lib/carriereJoueur";

const slugsDisponibles = await slugsAvecResultats();
// Équipes archivées exclues (demande du 29/09/2026) : leur dernier effectif
// faisait réapparaître des joueur·se·s déjà listé·e·s dans leur catégorie
// actuelle ; leurs saisons restent comptées dans le total de chacun·e, et
// leurs résultats visibles sur /equipes.
const equipes = trierEquipes(await getCollection("equipes")).filter(
	(e) => slugsDisponibles.has(e.data.slug) && e.data.statut !== "archivee",
);
// Une seule ligne par personne, dans sa catégorie actuelle (voir
// categorieActuelleParHash) -- `trierEquipes` range déjà du plus jeune au
// plus âgé, ordre attendu pour départager une égalité.
const categorieActuelle = await categorieActuelleParHash(equipes.map((e) => e.data.slug));

const blocs = await Promise.all(
	equipes.map(async (e) => ({
		equipe: e,
		carriere: await getCarriereParEquipe(e.data.slug, e.data.calendriers, e.data.affichageStats, categorieActuelle),
	})),
);

// Table fusionnée : quand une équipe partage sa poule (plusieursEquipes), les
// groupes ("Équipe 1"/"Équipe 2"...) deviennent une colonne "Catégorie"
// triable au lieu de sous-tableaux séparés -- c'est la seule notion de
// "catégorie" qui existe dans ce modèle de données pour une page qui est déjà
// elle-même organisée par équipe/catégorie d'âge (voir CLAUDE.md).
function joueursAffiches(carriere: { plusieursEquipes: boolean; groupes: { joueurs: JoueurCarriere[] }[] }): JoueurCarriere[] {
	return carriere.groupes.flatMap((g) => g.joueurs);
}

const formatRatio = (r: number | null) => (r == null ? "—" : r.toFixed(1));

// Colonnes chiffrées du tableau, décrites une fois : chaque cellule porte
// les DEUX valeurs (carrière et saison en cours) et la bascule "Saison en
// cours / Toute la carrière" choisit laquelle afficher et trier (voir le
// script plus bas) -- aucun recalcul côté navigateur.
type Totaux = Pick<JoueurCarriere, "matchsJoues" | "buts" | "sept_m" | "tirs" | "arrets" | "avertissements" | "exclusions" | "disqualifications" | "ratio">;
const COLONNES: { key: string; titre: string; valeur: (t: Totaux) => number | null; texte?: (t: Totaux) => string }[] = [
	{ key: "matchs", titre: "Matchs", valeur: (t) => t.matchsJoues },
	{ key: "buts", titre: "Buts", valeur: (t) => t.buts },
	{ key: "ratio", titre: "Buts/match", valeur: (t) => t.ratio, texte: (t) => formatRatio(t.ratio) },
	{ key: "sept_m", titre: "7m", valeur: (t) => t.sept_m },
	{ key: "tirs", titre: "Tirs", valeur: (t) => t.tirs },
	{ key: "arrets", titre: "Arrêts", valeur: (t) => t.arrets },
	{ key: "avertissements", titre: "Avert.", valeur: (t) => t.avertissements },
	{ key: "exclusions", titre: "Excl.", valeur: (t) => t.exclusions },
	{ key: "disqualifications", titre: "Disq.", valeur: (t) => t.disqualifications },
];
const texteCellule = (c: (typeof COLONNES)[number], t: Totaux) => (c.texte ? c.texte(t) : String(c.valeur(t)));
// Valeur de tri : -1 pour un ratio absent (aucun match), pour qu'il passe
// toujours après un vrai 0.0.
const valeurTri = (c: (typeof COLONNES)[number], t: Totaux) => c.valeur(t) ?? -1;
const attributsTri = (j: JoueurCarriere) =>
	Object.fromEntries(
		COLONNES.flatMap((c) => [
			[`data-value-${c.key}`, valeurTri(c, j)],
			[`data-saison-${c.key}`, valeurTri(c, j.saisonEnCours)],
		]),
	);
// La recherche ne porte que sur le nom AFFICHÉ (pseudonymisé le cas
// échéant) : c'est le seul nom présent dans la page pour ces lignes, un
// « Théo M. » n'est donc jamais retrouvable par son nom complet.
const pourRecherche = (texte: string) =>
	texte
		.normalize("NFD")
		.replace(/[̀-ͯ]/g, "")
		.toLowerCase();
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<Favicon />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Statistiques carrière — Handball Islois</title>
		<meta
			name="description"
			content="Cumul des statistiques de chaque joueur·se de l'effectif actuel, toutes saisons et catégories confondues."
		/>
		{
			/* Page destinée aux joueurs/coachs/dirigeants, accessible uniquement
			via un lien discret depuis /equipes -- volontairement absente du menu
			de navigation ET non indexée, comme /statistiques (voir
			src/pages/statistiques.astro). */
		}
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<Header />
		<PageBanner
			title="Statistiques carrière"
			subtitle="Cumul des statistiques de l'effectif actuel, toutes saisons et catégories confondues."
		/>

		{
			blocs.every(({ carriere }) => carriere.groupes.every((g) => g.joueurs.length === 0)) ? (
				<section class="carriere-content">
					<div class="wrap empty">
						<p>Aucune statistique disponible pour le moment.</p>
					</div>
				</section>
			) : (
				<section class="carriere-content">
					<div class="wrap">
						<label class="filtre-label" for="filtre-equipe">
							Choisir une équipe
						</label>
						<select id="filtre-equipe">
							{blocs
								.filter(({ carriere }) => carriere.groupes.some((g) => g.joueurs.length > 0))
								.map(({ equipe }) => (
									<option value={equipe.data.slug}>{equipe.data.nom}</option>
								))}
						</select>

						<div class="controles">
							<div class="bascule" role="group" aria-label="Période des statistiques">
								{/* Défaut "Toute la carrière" : c'est l'objet de la page ; la
								saison en cours reste à un clic, et /statistiques en donne déjà
								le bilan d'équipe. */}
								<button type="button" class="bascule-btn" data-vue="carriere" aria-pressed="true">Toute la carrière</button>
								<button type="button" class="bascule-btn" data-vue="saison" aria-pressed="false">Saison en cours</button>
							</div>
							<div class="recherche">
								<label class="filtre-label" for="recherche-joueur">Rechercher un nom</label>
								<input id="recherche-joueur" type="search" autocomplete="off" placeholder="Nom tel qu'affiché" />
								<p class="recherche-bilan" aria-live="polite"></p>
							</div>
						</div>

						{blocs.map(({ equipe, carriere }) => {
							const joueurs = joueursAffiches(carriere);
							return (
								<section class="equipe-bloc" id={`equipe-${equipe.data.slug}`} data-equipe-slug={equipe.data.slug}>
									<h2>{equipe.data.nom}</h2>
									<p class="note">
										<span class="v-carriere">Effectif actuel -- cumul toutes saisons et catégories confondues.</span>
										<span class="v-saison">Effectif actuel -- statistiques de la saison en cours uniquement.</span>
									</p>

									{joueurs.length > 0 && (
										<div class="table-scroll">
											<table class="joueurs">
												<thead>
													<tr>
														<th scope="col" aria-sort="none">
															<button type="button" class="sort-btn" data-key="joueur" data-type="text">
																Joueur·se
																<span class="sort-indicator" aria-hidden="true" />
															</button>
														</th>
														{carriere.plusieursEquipes && (
															<th scope="col" aria-sort="none">
																<button type="button" class="sort-btn" data-key="categorie" data-type="text">
																	Catégorie
																	<span class="sort-indicator" aria-hidden="true" />
																</button>
															</th>
														)}
														{COLONNES.map((c) => (
															<th scope="col" aria-sort="none">
																<button type="button" class="sort-btn" data-key={c.key} data-type="num">
																	{c.titre}
																	<span class="sort-indicator" aria-hidden="true" />
																</button>
															</th>
														))}
													</tr>
												</thead>
												<tbody>
													{joueurs.map((j, i) => {
														const aDetail = j.detail !== null && j.detail.length > 0;
														const detailId = `detail-${equipe.data.slug}-${i}`;
														return (
															<>
																<tr
																	class="joueur-row"
																	data-value-joueur={(j.label ?? "").toLowerCase()}
																	data-value-categorie={j.groupeLibelle.toLowerCase()}
																	data-recherche={pourRecherche(j.label ?? "")}
																	{...attributsTri(j)}
																	{...(aDetail
																		? { tabindex: "0", role: "button", "aria-expanded": "false", "aria-controls": detailId, "data-has-detail": "true" }
																		: {})}
																>
																	<td>
																		<span class="nom">{j.label}</span>
																		{j.nonVuCetteSaison && <span class="badge badge--discret">Non vu cette saison</span>}
																		{j.plusieursCategoriesCetteSaison && <span class="badge">Plusieurs catégories cette saison</span>}
																	</td>
																	{carriere.plusieursEquipes && <td>{j.groupeLibelle}</td>}
																	{COLONNES.map((c) => (
																		<td>
																			<span class="v-carriere">{texteCellule(c, j)}</span>
																			<span class="v-saison">{texteCellule(c, j.saisonEnCours)}</span>
																		</td>
																	))}
																</tr>
																{aDetail && (
																	<tr class="detail-row" id={detailId} hidden>
																		<td colspan={carriere.plusieursEquipes ? 11 : 10}>
																			{j.parcours.length > 1 && (
																				<div class="parcours">{j.parcours.map((e) => `${e.saison} ${e.equipeNom}`).join(" → ")}</div>
																			)}
																			<table class="detail">
																				<caption>Détail saison par saison de {j.label}</caption>
																				<thead>
																					<tr>
																						<th scope="col">Saison</th>
																						<th scope="col">Catégorie</th>
																						<th scope="col">Matchs</th>
																						<th scope="col">Buts</th>
																						<th scope="col">Buts/match</th>
																						<th scope="col">7m</th>
																						<th scope="col">Tirs</th>
																						<th scope="col">Arrêts</th>
																						<th scope="col">Avert.</th>
																						<th scope="col">Excl.</th>
																						<th scope="col">Disq.</th>
																					</tr>
																				</thead>
																				<tbody>
																					{j.detail!.map((e) => (
																						<tr>
																							<td>{e.saison}</td>
																							<td>{e.equipeNom}</td>
																							<td>{e.matchsJoues}</td>
																							<td>{e.buts}</td>
																							<td>{formatRatio(e.ratio)}</td>
																							<td>{e.sept_m}</td>
																							<td>{e.tirs}</td>
																							<td>{e.arrets}</td>
																							<td>{e.avertissements}</td>
																							<td>{e.exclusions}</td>
																							<td>{e.disqualifications}</td>
																						</tr>
																					))}
																				</tbody>
																			</table>
																		</td>
																	</tr>
																)}
															</>
														);
													})}
												</tbody>
											</table>
										</div>
									)}
								</section>
							);
						})}
					</div>
				</section>
			)
		}

		<Footer />

		<script>
			const select = document.querySelector<HTMLSelectElement>("#filtre-equipe");
			const blocs = document.querySelectorAll<HTMLElement>(".equipe-bloc");

			function afficherEquipe(slug: string) {
				for (const bloc of blocs) {
					bloc.hidden = bloc.dataset.equipeSlug !== slug;
				}
			}

			if (select && blocs.length > 0) {
				// Lien discret depuis la fiche équipe (ex. #equipe-seniors-masculins) :
				// présélectionne cette équipe dans le filtre, en plus du saut
				// d'ancre natif du navigateur (qui fonctionne même sans JS).
				const slugDepuisAncre = location.hash.replace(/^#equipe-/, "");
				const optionCorrespondante = slugDepuisAncre && select.querySelector(`option[value="${slugDepuisAncre}"]`);
				if (optionCorrespondante) select.value = slugDepuisAncre;

				afficherEquipe(select.value);
				select.addEventListener("change", () => afficherEquipe(select.value));
			}

			// --- Tri par colonne -------------------------------------------------
			// Chaque table.joueurs est triée indépendamment. Le tri déplace les
			// paires [ligne joueur, ligne détail éventuelle] ensemble pour que le
			// détail reste toujours juste sous son joueur après un tri.
			function ligneEtDetail(tbody: HTMLTableSectionElement) {
				const groupes: { main: HTMLTableRowElement; detail: HTMLTableRowElement | null }[] = [];
				const rows = [...tbody.rows];
				for (let i = 0; i < rows.length; i++) {
					const row = rows[i];
					if (row.classList.contains("detail-row")) continue; // déjà rattachée à la ligne précédente
					const next = rows[i + 1];
					const detail = next && next.classList.contains("detail-row") ? next : null;
					groupes.push({ main: row, detail });
				}
				return groupes;
			}

			// Vue affichée : "carriere" (défaut) ou "saison". Les chiffres des deux
			// vues sont déjà dans la page (data-value-* / data-saison-*), seul le
			// choix de lecture change.
			let vue: "carriere" | "saison" = "carriere";
			const contenu = document.querySelector<HTMLElement>(".carriere-content");

			function valeurTri(row: HTMLTableRowElement, key: string, type: string): string | number {
				const suffixe = `${key.charAt(0).toUpperCase()}${key.slice(1)}`;
				const brut = type === "num" && vue === "saison" ? row.dataset[`saison${suffixe}`] : row.dataset[`value${suffixe}`];
				if (type === "num") return Number(brut ?? 0);
				return brut ?? "";
			}

			/** Retrie chaque tableau déjà trié, après une bascule de vue : sans
			 * ça, l'ordre affiché correspondrait encore aux chiffres de l'autre
			 * vue. */
			const retris: (() => void)[] = [];

			for (const table of document.querySelectorAll<HTMLTableElement>("table.joueurs")) {
				const tbody = table.tBodies[0];
				if (!tbody) continue;
				const headers = [...table.querySelectorAll<HTMLButtonElement>("thead .sort-btn")];

				let triActuel: { key: string; sens: 1 | -1 } | null = null;

				for (const bouton of headers) {
					bouton.addEventListener("click", () => {
						const key = bouton.dataset.key!;
						const type = bouton.dataset.type ?? "text";
						// Un nouveau tri démarre décroissant pour un chiffre (la meilleure
						// valeur en tête, ce qu'on veut voir en premier) et croissant pour
						// du texte (ordre alphabétique) ; un second clic sur la même colonne
						// bascule simplement le sens en cours, quel qu'il soit.
						const sens: 1 | -1 = triActuel?.key === key ? (triActuel.sens === 1 ? -1 : 1) : type === "num" ? -1 : 1;
						triActuel = { key, sens };
						trier(bouton, key, type, sens);
					});
				}

				retris.push(() => {
					const bouton = headers.find((b) => b.dataset.key === triActuel?.key);
					if (triActuel && bouton) trier(bouton, triActuel.key, bouton.dataset.type ?? "text", triActuel.sens);
				});

				function trier(bouton: HTMLButtonElement, key: string, type: string, sens: 1 | -1) {
					const groupes = ligneEtDetail(tbody);
					groupes.sort((a, b) => {
						const va = valeurTri(a.main, key, type);
						const vb = valeurTri(b.main, key, type);
						if (typeof va === "number" && typeof vb === "number") return (va - vb) * sens;
						return String(va).localeCompare(String(vb), "fr") * sens;
					});

					for (const { main, detail } of groupes) {
						tbody.append(main);
						if (detail) tbody.append(detail);
					}
					// Un tri qui laisse la fenêtre de défilement où elle était montrerait
					// une ligne quelconque en haut plutôt que la nouvelle tête de tri.
					table.closest<HTMLElement>(".table-scroll")?.scrollTo(0, 0);

					for (const th of table.querySelectorAll("thead th")) th.setAttribute("aria-sort", "none");
					bouton.closest("th")?.setAttribute("aria-sort", sens === 1 ? "ascending" : "descending");
					for (const autre of headers) autre.classList.toggle("is-sorted", autre === bouton);
					bouton.dataset.sens = String(sens);
				}
			}

			// --- Bascule "Toute la carrière" / "Saison en cours" ------------------
			const boutonsVue = [...document.querySelectorAll<HTMLButtonElement>(".bascule-btn")];
			for (const bouton of boutonsVue) {
				bouton.addEventListener("click", () => {
					vue = bouton.dataset.vue === "saison" ? "saison" : "carriere";
					contenu?.setAttribute("data-vue", vue);
					for (const b of boutonsVue) b.setAttribute("aria-pressed", String(b === bouton));
					for (const retrier of retris) retrier();
				});
			}

			// --- Recherche par nom affiché ----------------------------------------
			// Porte sur toutes les équipes à la fois (on ne sait pas toujours dans
			// quelle catégorie joue quelqu'un) ; une recherche vide rend la main
			// au filtre par équipe.
			const recherche = document.querySelector<HTMLInputElement>("#recherche-joueur");
			const bilan = document.querySelector<HTMLElement>(".recherche-bilan");
			const normaliser = (t: string) =>
				t
					.normalize("NFD")
					.replace(/[̀-ͯ]/g, "")
					.toLowerCase()
					.trim();

			function appliquerRecherche() {
				const terme = normaliser(recherche?.value ?? "");
				let trouves = 0;
				for (const bloc of blocs) {
					let dansBloc = 0;
					for (const row of bloc.querySelectorAll<HTMLTableRowElement>("tr.joueur-row")) {
						const visible = !terme || (row.dataset.recherche ?? "").includes(terme);
						row.hidden = !visible;
						const detail = row.getAttribute("aria-controls") && document.getElementById(row.getAttribute("aria-controls")!);
						if (detail && !visible) {
							detail.hidden = true;
							row.setAttribute("aria-expanded", "false");
						}
						if (visible) dansBloc++;
					}
					trouves += dansBloc;
					bloc.hidden = terme ? dansBloc === 0 : bloc.dataset.equipeSlug !== select?.value;
				}
				if (bilan) bilan.textContent = terme ? (trouves === 0 ? "Aucun nom trouvé." : `${trouves} résultat${trouves > 1 ? "s" : ""}, toutes équipes confondues.`) : "";
			}
			recherche?.addEventListener("input", appliquerRecherche);
			select?.addEventListener("change", () => {
				if (recherche?.value) {
					recherche.value = "";
					appliquerRecherche();
				}
			});

			// --- Détail par joueur (clic sur une ligne nominative) ---------------
			// Seules les lignes marquées `data-has-detail` (affichage nominatif,
			// voir carriereJoueur.ts) sont cliquables : une ligne pseudonymisée
			// n'ouvre jamais de détail individuel.
			function toggleDetail(row: HTMLTableRowElement) {
				const id = row.getAttribute("aria-controls");
				const detailRow = id && document.getElementById(id);
				if (!detailRow) return;
				const ouvert = row.getAttribute("aria-expanded") === "true";
				row.setAttribute("aria-expanded", String(!ouvert));
				detailRow.hidden = ouvert;
			}

			for (const row of document.querySelectorAll<HTMLTableRowElement>("tr.joueur-row[data-has-detail]")) {
				row.addEventListener("click", () => toggleDetail(row));
				row.addEventListener("keydown", (e) => {
					if (e.key === "Enter" || e.key === " ") {
						e.preventDefault();
						toggleDetail(row);
					}
				});
			}
		</script>
	</body>
</html>

<style>
	.carriere-content {
		background: var(--color-navy-deep);
	}
	.wrap {
		max-width: 900px;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
	}
	.empty p {
		color: rgba(255, 255, 255, 0.75);
		text-align: center;
	}
	.filtre-label {
		display: block;
		color: var(--color-white);
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.4rem;
	}
	select {
		width: 100%;
		min-height: 44px;
		padding: 0.6rem 0.8rem;
		font-size: 1rem;
		border-radius: 4px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: var(--color-navy-deep);
		color: var(--color-white);
		margin-bottom: 1.5rem;
	}
	/* Bascule de vue : les deux valeurs sont dans chaque cellule, une seule
	   est montrée selon data-vue (posé par le script sur .carriere-content). */
	.v-saison {
		display: none;
	}
	.carriere-content[data-vue="saison"] .v-saison {
		display: inline;
	}
	.carriere-content[data-vue="saison"] .v-carriere {
		display: none;
	}
	.controles {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: flex-end;
		margin-bottom: 1.5rem;
	}
	.bascule {
		display: inline-flex;
		border: 1px solid color-mix(in srgb, var(--color-white) 30%, transparent);
		border-radius: 4px;
		overflow: hidden;
	}
	.bascule-btn {
		min-height: 44px;
		padding: 0.5rem 1rem;
		font: inherit;
		font-size: 1rem;
		color: var(--color-white);
		background: transparent;
		border: 0;
		cursor: pointer;
	}
	.bascule-btn + .bascule-btn {
		border-left: 1px solid color-mix(in srgb, var(--color-white) 30%, transparent);
	}
	.bascule-btn[aria-pressed="true"] {
